# Neo4j credentials (local only; never commit)
.neo4j_password
_database/_system/.neo4j_password

# Optional local SQLite rebuild (not part of the Neo4j plan deliverable)
_database/_system/reuse_ontology.sqlite

# Local Neo4j rollback backups (large, machine-specific)
