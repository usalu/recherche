.laputa/settings.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Python bytecode (never commit)
__pycache__/
*.py[cod]
*$py.class
