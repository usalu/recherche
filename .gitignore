# Neo4j credentials (local only; never commit)
.neo4j_password
_database/_system/.neo4j_password

# Optional local SQLite rebuild (not part of the Neo4j plan deliverable)
_database/_system/reuse_ontology.sqlite

# Local Neo4j rollback backups (large, machine-specific)
_neo4j/review/backups/

# Tolaria app files (machine-specific, never commit)
.laputa/settings.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Python bytecode (never commit)
__pycache__/
*.py[cod]
*$py.class

# Crash/debug logs
*.log
debug.log

# Local rollback snapshots (large, machine-specific)
_neo4j/backups/

# Scratch / regenerable working area (never commit)
_tmp/

# Rendered diagrams (regenerable from the .dot next to them, which IS tracked).
# Drop these three lines if you want the printable sheets under version control.
_neo4j/exports/diagrams/*.pdf
_neo4j/exports/diagrams/*.svg
_neo4j/exports/diagrams/*.png

# Abandoned Figma icon/upload automation (regenerable one-off tooling)
_images/**/_chunk_scripts/
_images/assests/_*
_images/_apply_*.py
_images/_gen_*.py
_images/_mcp_*.js
_images/_figma_*.js
_images/*.jpg
_images/*b64*.txt
