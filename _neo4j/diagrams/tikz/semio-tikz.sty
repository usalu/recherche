\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-tikz}[2026/08/06 v0.1.0 semio identity for TikZ figures]
%
% semio-compliant TikZ styles. Colour is state (never kind), corners are square,
% strokes are the three semio print widths, type is Anta / Share Tech Mono.
% Colours + strokes + sizes come from semio-tikz-tokens.tex (generated by
% _scripts/gen_semio_tikz_tokens.py — do not hand-pick a hex here).
%
% Compile with a Unicode engine (Tectonic / LuaLaTeX / XeLaTeX), never pdflatex:
% fonts load by file path via fontspec, so a missing font is a hard error, not a
% silent fallback.

\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,calc}
\RequirePackage{fontspec}
\input{semio-tikz-tokens.tex}

% -- fonts -----------------------------------------------------------------
% Resolve the semio font root (holds anta/ and share-tech-mono/). Tectonic loads
% fonts by RELATIVE path via kpathsea; absolute drive paths fail. Probe from the
% compile dir (_neo4j/diagrams/tikz). Override before \usepackage if the semio
% checkout is elsewhere:  \def\semiofontroot{../relative/path/to/print/asset/font/}
% Fonts are vendored under fonts/ beside this package (Anta, Share Tech Mono).
% Path is relative to the compile dir; render_tikz.py compiles with that as cwd.
\providecommand{\semiofontroot}{fonts/}
\newfontfamily\SemioSans[Path=\semiofontroot anta/]{Anta-Regular.ttf}
\newfontfamily\SemioMono[Path=\semiofontroot share-tech-mono/]{ShareTechMono-Regular.ttf}
\setmainfont{Anta-Regular.ttf}[Path=\semiofontroot anta/]
\let\SemioSerif\SemioSans % Anta is the only text face; no italic exists

% type at the semio print sizes (pt, from the tokens)
\newcommand{\semiobodyfont}{\SemioSans\fontsize{\semiobodysize}{11.5pt}\selectfont}
\newcommand{\semiochipfont}{\SemioSans\fontsize{\semiochipsize}{8.6pt}\selectfont}
\newcommand{\semiomonofont}{\SemioMono\fontsize{\semiochipsize}{8.6pt}\selectfont}

% -- styles ----------------------------------------------------------------
\tikzset{
  % A node body: neutral fill, hairline border, square corners, Anta caption.
  semio node/.style={
    rectangle, sharp corners, line join=miter,
    draw=semionodestroke, fill=semionodefill, text=semionodefont,
    line width=\semiohairline, font=\semiobodyfont,
    align=left, inner xsep=6pt, inner ysep=4pt, minimum height=7mm,
  },
  % The focal entity only (semio's nodeFillSelected accent). Use sparingly.
  semio focus/.style={
    semio node, draw=semiofocusstroke, fill=semiofocusfill, text=semiofocusfont,
    line width=\semiofocuswidth,
  },
  % A category/hub node — same neutral body, wider, for tree parents.
  semio hub/.style={ semio node, fill=semiocanvas, minimum height=7mm },
  % Kind chip: muted, chip size — sits above a caption, left aligned.
  semio chip/.style={ font=\semiochipfont, text=semionodechip },
  % Machine text (ids, counts, provenance): Share Tech Mono, muted.
  semio mono/.style={ font=\semiomonofont, text=semiomuted },
  % Edges: one hairline colour for the whole sheet; multiplicity may step to
  % \semiodefaultstroke then \semiofocuswidth — never a fourth width.
  semio edge/.style={ draw=semioedgestroke, line width=\semiohairline, line join=miter },
  semio edge strong/.style={ semio edge, line width=\semiodefaultstroke },
  semio arrow/.style={ semio edge, -{Stealth[length=4pt,width=3pt]} },
  % Edge/label chip carried on the sheet surface so a line doesn't cross it.
  semio edge label/.style={ font=\semiochipfont, text=semiomuted, fill=semiobase, inner sep=1.5pt },
  % Register (legend): hairline frame, canvas fill, chip type.
  semio register/.style={
    rectangle, sharp corners, draw=semionodestroke, fill=semiocanvas,
    line width=\semiohairline, align=left, inner sep=6pt,
    font=\semiochipfont, text=semionodefont,
  },
}

% \SemioNode{<kind chip>}{<caption>} — kind stated typographically above the caption.
% Use as the label of a `semio node`:  \node[semio node] {\SemioNode{Huerde}{Witterung/Feuchte}};
\newcommand{\SemioNode}[2]{{\semiochipfont\textcolor{semionodechip}{#1}}\\[1pt]{\semiobodyfont #2}}
% Focus variant (chip readable on the accent body).
\newcommand{\SemioFocusNode}[2]{{\semiochipfont\textcolor{semiofocuschip}{#1}}\\[1pt]{\semiobodyfont #2}}

\endinput
