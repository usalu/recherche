              "Layer",
              "Marktmodell",
              "Defekt",
              "MatchingQualitaet",
              "ZustandsKlasse",
              "Akzeptanz"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
