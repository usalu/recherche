  "modeling_rules": {
    "central_occurrence_node": "Bauteilgruppe replaces the previously suggested ReuseEinsatz label. Each Bauteilgruppe represents one concrete reused component group/application in a case.",
    "bauteiltyp_rule": "Bauteiltyp remains a controlled vocabulary exactly as provided; Bauteilgruppe instances connect to Bauteiltyp via HAT_BAUTEILTYP.",
    "source_rule": "All evidence is anchored in Quelle nodes through BELEGT_IN. The BELEGT_IN relationship can carry properties such as felder, source_ref, note, quote, page, url, and datenqualitaet.",
    "datenqualitaet_rule": "Datenqualitaet is always a property, not a node. Recommended values are listed in property_enums.datenqualitaet.",
    "kennwert_rule": "Kennwerte are properties, not nodes. Put them on the scoped node: project area on Projekt/Bauwerk, component weight/volume/CO2 on Bauteilgruppe, reuse percentage on Fallbeispiel/Projekt, etc.",
    "minimum_degree_rule": "Do not create a node unless it can get at least two relationships. Bauteilgruppe should normally have at least GEHOERT_ZU_FALLBEISPIEL, HAT_BAUTEILTYP, NUTZT_MATERIAL, and BELEGT_IN.",
    "actor_rule": "Use Akteur for people and organizations. Classify through Akteurtyp and role through Akteurrolle; avoid special actor labels for sectors.",
    "project_case_rule": "Fallbeispiel is the analytical case; Projekt is the concrete project. Complex reuse chains may have multiple Projekt and Bauwerk nodes under one Fallbeispiel.",
    "bauwerk_rule": "Bauwerk is classified through Bauobjektklasse and Bauobjektrolle; donor/receiver links from Bauteilgruppe use AUS_BAUWERK and EINGEBAUT_IN."
