        "name_full": "UMAR Unit — Urban Mining and Recycling, NEST Empa Dübendorf",
        "latitude": 47.4023749,
        "geo_aktualisiert_am_utc": "2026-06-05T23:17:08.724300+00:00",
        "entwurfsqualitaet_am_utc": "2026-06-05T19:25:30.538804+00:00",
        "entwurfsbeschreibung_quelle": "_neo4j/intake/archive/2026-06-05_entwurfsqualitaet/designQuality.md",
        "name": "UMAR Unit",
        "adresse": "Überlandstrasse 129, 8600 Dübendorf, Switzerland",
        "geo_confidence": "high",
        "entwurfsbeschreibung": "UMAR is a research apartment designed as a catalogue of reversible material cycles. Most components are selected for separability, take-back, reuse, recycling or compostability; reclaimed Jules Wabbes door handles add a small but explicit reused-component layer. The architectural output is a clean demonstrator rather than a salvage collage: dry joints, modular layers, visible systems and controlled material contrasts show how a dwelling can be designed for future disassembly and resource recovery.",
        "entwurfsqualitaet_run": "entwurfsqualitaet_v2_2026_06_05",
        "metadata_sidecar_key": "node:p_umar_unit",
        "id": "p_umar_unit",
        "geo_import_run": "2026-06-06_project_bg_geo_extract",
        "projektstatus_text": "active research demonstrator in NEST since 2018",
        "longitude": 8.6114852
      }
