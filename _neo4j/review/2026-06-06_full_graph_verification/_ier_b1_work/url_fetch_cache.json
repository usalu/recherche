-97.webp\\\",\\\"path\\\":\\\"images/o0gogd4q/production/2f8a547dd37b8bf054f7a497c6f0a2fb89002c14-3000x2000.webp\\\",\\\"sha1hash\\\":\\\"2f8a547dd37b8bf054f7a497c6f0a2fb89002c14\\\",\\\"size\\\":566628,\\\"uploadId\\\":\\\"wUIy3jnEbPOeqzmOVcw7zgeqvgwEMnoy\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/2f8a547dd37b8bf054f7a497c6f0a2fb89002c14-3000x2000.webp\\\"}}},{\\\"_key\\\":\\\"24e18dd990d7\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"0abdbcf1b4f8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The meal as an inclusive meeting point\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h2\\\"},{\\\"_key\\\":\\\"1b91b9d220b5\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"82075ba1cc6b\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"As the focal point of their partnership, Thoravej 29 and Meyers have together developed a new concept for the house’s member restaurant: Langar\\\"},{\\\"_key\\\":\\\"2733496af462\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\".\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"1c1f95132c1a\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"1730350c0631\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Langar is inspired by Eastern traditions, and the goal is for the kitchen to create space for cross-disciplinary encounters and to foster inclusion. In practice, this means that all members of the house are encouraged to take part in the dining experiences and thereby become co-creators of both culture and meals.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"093191560b76\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"351702452eed\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The dining experience is built on a set of core principles: meals are based on the season, have a plant-based foundation, and use many ingredients from the in-house pantry. This means that lunch is created using as many local ingredients as possible and primarily vegetables and legumes—seasoned and refined with homemade pickled and fermented goods, and enjoyed together at long communal tables.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"headline\\\":\\\"Food\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T10:38:19Z\\\",\\\"_id\\\":\\\"image-3a75cdfcb2e80d91eb24115ca6e80682c1334ce2-2000x3000-webp\\\",\\\"_rev\\\":\\\"0rMzyCcxaZvfkTfPcg5miO\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T11:11:34Z\\\",\\\"altText\\\":null,\\\"assetId\\\":\\\"3a75cdfcb2e80d91eb24115ca6e80682c1334ce2\\\",\\\"creditLine\\\":null,\\\"description\\\":\\\"Copyright: Emil Basse\\\",\\\"extension\\\":\\\"webp\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"dPH-DFjE%Ls-~AtRRPxu%NM{xaWBj]xtofogozozxaog\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.6666666666666666,\\\"height\\\":3000,\\\"width\\\":2000},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#664a32\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":6.88,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#7e310d\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.61,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#b47d49\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.23,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#ceb49f\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":4.78,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#e6b180\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0.6,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#ac54ac\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#b47d49\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.23,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/webp\\\",\\\"opt\\\":{\\\"media\\\":{\\\"tags\\\":null}},\\\"originalFilename\\\":\\\"AHC_Gathering_M-47.webp\\\",\\\"path\\\":\\\"images/o0gogd4q/production/3a75cdfcb2e80d91eb24115ca6e80682c1334ce2-2000x3000.webp\\\",\\\"sha1hash\\\":\\\"3a75cdfcb2e80d91eb24115ca6e80682c1334ce2\\\",\\\"size\\\":370590,\\\"title\\\":null,\\\"uploadId\\\":\\\"sYCqj6ej3bFX89OzciK9HeyHXp2pUZFp\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/3a75cdfcb2e80d91eb24115ca6e80682c1334ce2-2000x3000.webp\\\"}}},{\\\"_key\\\":\\\"f30f4a87adfc\\\",\\\"_type\\\":\\\"section\\\",\\\"content\\\":[{\\\"_key\\\":\\\"21134bd26e9b\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"a5e01ea79aa3\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"We promote a circular economy:\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h2\\\"},{\\\"_key\\\":\\\"7ac5b38e246c\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"011c054b88c4\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"We only purchase new products when necessary.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"1607821ba943\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"9c9e50fce256\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"We make use of reuse and recycling when it makes sense from an overall perspective.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"02f067ffe9b3\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"48012bf9754f\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"We explore opportunities for take-back schemes and resale of used equipment.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"9a2c26d6c7a2\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"b52428d8b820\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"We reduce our climate footprint through:\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h2\\\"},{\\\"_key\\\":\\\"21da403e126e\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"ae2d5adad248\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The use of low-emission transport solutions, such as electric vehicles, train transport, and carpooling.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"88571f4c4aa8\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"de03855573c8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Prioritizing energy-efficient products with good energy ratings.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"c90925ee4669\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"46e517daf008\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Purchasing electricity from renewable energy sources.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"ba90bba75189\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"55fe6b5e75f9\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"We prefer certified products, such as:\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h2\\\"},{\\\"_key\\\":\\\"9653a816dda1\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"6fe96c6697ee\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Organic products\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"57bef20a8b92\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"44867577efe3\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"dc67db3d305b\\\"],\\\"text\\\":\\\"The Nordic Swan Ecolabel\\\"},{\\\"_key\\\":\\\"a6229ffa56ca\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" and \\\"},{\\\"_key\\\":\\\"ae92b9812aff\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"14721001b350\\\"],\\\"text\\\":\\\"the EU Ecolabel\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[{\\\"_key\\\":\\\"dc67db3d305b\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.svanemaerket.dk/\\\",\\\"internalLink\\\":null},{\\\"_key\\\":\\\"14721001b350\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.eublomsten.dk/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"2c8a48f04aae\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"da70b5e04a0d\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"2b6e31b94486\\\"],\\\"text\\\":\\\"FSC-certified wood\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[{\\\"_key\\\":\\\"2b6e31b94486\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.verdensskove.org/fsc-maerket/?gad_source=1\\u0026gad_campaignid=22515969335\\u0026gclid=CjwKCAjw3tzHBhBREiwAlMJoUm0851XkKwbKAoqYpQ7gVTdvyvomz6isaw275J9BPS3Ndz_jGZQNxxoC-ocQAvD_BwE\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"99c9e6a24023\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"2b0dbc80a7dc\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Products with climate labels or available climate data\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"2d2e1f613c77\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"dd5284c8ad0f\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"We collaborate with suppliers who take responsibility\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h2\\\"},{\\\"_key\\\":\\\"35c67ffc4e8f\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"ec5fcca6ce5a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"For larger projects, we place positive emphasis on suppliers who:\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"b7d3d27d67df\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"351b1ea9f8d0\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Take social responsibility.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"136aa5e21877\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"8bd7464debc8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Support local production.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"944cc40eb0ec\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"31768dc4d918\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Have targets for climate and biodiversity.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"fb62d1081664\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"2a7d429986f3\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Can document how they comply with our guidelines.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"headline\\\":\\\"Responsible Purchasing\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T10:48:54Z\\\",\\\"_id\\\":\\\"image-eef9c4e6e995950d11388516b92da2e802e16ac2-5504x7339-jpg\\\",\\\"_rev\\\":\\\"0rMzyCcxaZvfkTfPcfyedM\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T10:48:54Z\\\",\\\"assetId\\\":\\\"eef9c4e6e995950d11388516b92da2e802e16ac2\\\",\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"dLD+oB0K=zoeXx=}IoRk.jVZIo%3TBWFs:IVJ}W;Rks:\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.7499659354135441,\\\"height\\\":7339,\\\"width\\\":5504},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#3e2122\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":3.93,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#6f2218\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":1.8,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#3e2122\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":3.93,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#d6aec5\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":1.41,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c16975\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":1.34,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#b29376\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":2.12,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#cc3445\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":3.57,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"originalFilename\\\":\\\"DSC_6166.jpeg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/eef9c4e6e995950d11388516b92da2e802e16ac2-5504x7339.jpg\\\",\\\"sha1hash\\\":\\\"eef9c4e6e995950d11388516b92da2e802e16ac2\\\",\\\"size\\\":27809763,\\\"uploadId\\\":\\\"2HS6Jx2e5FIURufIU0boCGT61GnxDRet\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/eef9c4e6e995950d11388516b92da2e802e16ac2-5504x7339.jpg\\\"}}},{\\\"_key\\\":\\\"6e3ca954b8de\\\",\\\"_type\\\":\\\"section\\\",\\\"content\\\":[{\\\"_key\\\":\\\"631d0074c9d7\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"253b4e087bf8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The building consists of a heavy structure with thermal mass, which will passively help maintain a good indoor climate.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"3e8b140123e0\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"a7647619b779\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"As part of the renovation, a large portion of the heavy structures will be exposed, making it easier for heat and cold to be “stored” in the concrete floors, walls, and ceilings. This principle is actively used in connection with the night cooling strategy implemented in the building.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"4272007b43d8\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"c0ab17cabbae\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Specifically, this means that the fans of the ventilation systems are switched on at night during the warmest weeks of summer, allowing cool outside air to be blown into the building when users are not present. In this way, cooling is stored in the concrete structures and furniture, and during the day, the walls, furniture, and ceilings gradually release the stored coolness into the air as it warms up from people, sunlight, and the large technical façade.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"933b775a1d88\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"2d5c8626f18b\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The technical façade is also part of the renovation. In addition to distributing the technical installations throughout the building, it contributes to passive solar heating during the winter months, thereby reducing the need for radiators and similar heating systems.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"594d07e81ca8\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"220fb77fa000\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Furthermore, several active measures have been implemented to help reduce the building’s overall energy consumption:\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"d4fb55c43dc6\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"4b6c8e48144e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Motion sensors and daylight control\\\"},{\\\"_key\\\":\\\"386b39d37d07\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" on lighting in many rooms adjust brightness and energy use according to daylight conditions and occupancy.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"e5e24ea58ec1\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"e83d6be0bae9\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Ventilation\\\"},{\\\"_key\\\":\\\"8f78d546c755\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" operates as a mix of constant and variable air volume zones. The latter means that airflow and thus energy use are adjusted in several rooms (e.g., meeting rooms) based on occupancy, CO₂ levels, and room temperature.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"4d942c1d06ab\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"cea535687658\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"As a user, you can control the lighting yourself. However, it is recommended to follow the automated system, which assesses whether daylight levels are sufficient to avoid artificial lighting—this helps save electricity.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"040cf131c3de\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"c4dcbc79ac31\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Indoor Climate and Building Use\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"810296f12fde\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"c52e8ea855f8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The building is equipped with a central radiator system and balanced mechanical ventilation with integrated cooling via heat pumps. These systems are controlled centrally through a Building Management System (BMS) operated by Facility Management.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"fee41b4dc716\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"a0ed485b29c6\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Ventilation\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"e6abb6f33e04\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"13a484bfb8e4\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Ventilation is centrally controlled based on fixed temperature and CO₂ levels in each room. The building is designed so that natural ventilation is not required, and in some cases, opening the windows may worsen conditions. The ventilation system includes integrated cooling, where the supply air temperature is centrally controlled and adjusted based on the overall needs of individual rooms. The supply temperature can vary between 17–21 °C. Users cannot manually regulate the ventilation.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"4544b428c4d4\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"be53c2e4a1d0\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Heating\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"b2661ce88a4c\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"174a844d56a1\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The building’s heating system consists of radiators, each equipped with a thermostat allowing users to regulate room temperature in individual rooms or zones. It is expected that the temperature in the building will rise during the day due to heat from occupants and equipment.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"d1decb45b1c9\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"c89d657e2116\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The radiators are dimensioned to maintain a room temperature of around 21 °C on a cold day when the outdoor temperature may drop to approximately -12 °C.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"814aace732cd\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"74b9632f0c5c\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"In rare cases where the outdoor temperature is below -12 °C, or if the district heating and system capacity cannot keep up, the temperature may not reach 21 °C.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"5c43f480056b\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"876db57a5a66\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"As a user, you can adapt your clothing for both winter and summer. Draw the curtains when the sun shines directly on the windows to avoid unnecessary heating, and close the curtains when leaving during warm periods to keep the building cooler the next morning.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"2bc03b90e4a3\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"adbcc665bd61\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Adjusting the Indoor Climate\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"64dfc776e699\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"c2d215d86b64\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"In general, users have the most opportunities to adjust the indoor climate during winter, when radiators and clothing are the main tools to ensure comfortable thermal conditions.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"8bde2971c0b6\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"81755d1a77d8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"During summer, heating is typically shut off, and windows can be opened. However, since the building is equipped with mechanical cooling, opening windows can lead to energy waste, as the indoor air is often cooler than the outdoor air on hot days. Therefore, from an energy perspective, it is generally not recommended to open windows when the sun is on the façade. On the other hand, air movement from open windows can improve perceived comfort since airflow feels cooling.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"c9cf026267b6\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"162080ac1a92\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Adjusting clothing is one way users can optimize their own comfort. In rooms with curtains, it is highly beneficial to draw them when sunlight enters through the windows. This also reduces the building’s energy consumption for cooling throughout the year if users remember to close the curtains when leaving during warm periods.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"7bef1a2f88fa\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"68032f9154c6\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Water Conservation\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"12e06b5f992d\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"65e9b33c1af4\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Most of the building’s water installations are retained. Some sanitary fixtures and fittings are replaced, and additional ones are added in the restroom cores. Where new fixtures and fittings are installed, they are equipped with water-saving aerators to reduce consumption.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"a3c3b6d6f089\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"f1488e8f872b\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"As a user, you can help by avoiding unnecessary water use—for example, turn off the tap while soaping your hands. Additionally, only use the large toilet flush when necessary.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"headline\\\":\\\"Energy Eficiency\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T11:06:01Z\\\",\\\"_id\\\":\\\"image-3f9abe617d657146efbe12bb4a5a68730bad45eb-3595x4972-jpg\\\",\\\"_rev\\\":\\\"JLKvYdmWOE02vgBAPyQ8qd\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T11:11:06Z\\\",\\\"altText\\\":null,\\\"assetId\\\":\\\"3f9abe617d657146efbe12bb4a5a68730bad45eb\\\",\\\"creditLine\\\":null,\\\"description\\\":\\\"Copyright: Thom Geraeds\\\",\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"dNHoL09F~qRiIBoeRjRj4naeIBoff5t7R*f8IUxuRjt7\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.7230490748189863,\\\"height\\\":4972,\\\"width\\\":3595},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#44443c\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":3.62,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#534e31\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#8f8e79\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":6.49,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c9c4a4\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0.11,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#cdc9ab\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#8f8e79\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":6.49,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#a0975e\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"opt\\\":{\\\"media\\\":{\\\"tags\\\":null}},\\\"originalFilename\\\":\\\"Thom_Geraeds_June254A1700-2.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/3f9abe617d657146efbe12bb4a5a68730bad45eb-3595x4972.jpg\\\",\\\"sha1hash\\\":\\\"3f9abe617d657146efbe12bb4a5a68730bad45eb\\\",\\\"size\\\":6107107,\\\"title\\\":null,\\\"uploadId\\\":\\\"OTJp5zSjcGhx8MHxE6QYXX0V92lmjRQj\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/3f9abe617d657146efbe12bb4a5a68730bad45eb-3595x4972.jpg\\\"}}},{\\\"_key\\\":\\\"e39e24b63178\\\",\\\"_type\\\":\\\"section\\\",\\\"content\\\":[{\\\"_key\\\":\\\"6bd2014a7e5f\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"a06b11eb7b10\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Cleaning is carried out by the cleaning company \\\"},{\\\"_key\\\":\\\"42781d63c159\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"c54f4ef6edc4\\\"],\\\"text\\\":\\\"Service by Larsen\\\"},{\\\"_key\\\":\\\"98d8c19ac182\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\", which places a particular focus on sustainability.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"c54f4ef6edc4\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://servicebylarsen.dk/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"cb0c4efad235\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"1d78430980e1\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Their product portfolio emphasizes climate adaptation. Among other things, they use climate-friendly cleaning machines and agents that are \\\"},{\\\"_key\\\":\\\"905c973749d6\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"da2911bdb893\\\"],\\\"text\\\":\\\"Cradle-to-Cradle\\\"},{\\\"_key\\\":\\\"0d2598d6ecba\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" certified. This means that the electricity used in the production of the cleaning agents comes exclusively from renewable energy sources, and the required process heat is generated using climate-neutral natural gas. Their manufacturer doses the products directly, which reduces CO₂ emissions by minimizing the transport of heavy, pre-mixed liquids.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"da2911bdb893\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://c2ccertified.org/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"c2ef77bf7b89\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"36cd759ae986\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"In addition, Service by Larsen collaborates with their clients to establish recycling stations that promote proper waste management and reuse.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"10c1193b907b\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"eb545dae2e68\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Service by Larsen also works to minimize negative impacts on biodiversity by choosing products that support this goal — such as their environmentally friendly cleaning products and FSC-certified wood.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"e414cddae075\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"5bcdec1fde7a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"As part of their commitment to social sustainability, Service by Larsen has adopted a policy of not performing night work. Furthermore, they collaborate with \\\"},{\\\"_key\\\":\\\"c5c8d39e7a21\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"em\\\",\\\"387a0fc6267f\\\"],\\\"text\\\":\\\"Glad Food\\\"},{\\\"_key\\\":\\\"79efeab7ed54\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" on selected projects to include marginalized individuals with disabilities in their operations.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"387a0fc6267f\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.gladmad.dk/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"}],\\\"headline\\\":\\\"Cleaning\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-07-31T13:17:37Z\\\",\\\"_id\\\":\\\"image-fee4409a61d89dcabbe2624233c663f24526e27e-1920x2560-jpg\\\",\\\"_rev\\\":\\\"WSns53MIaqc9Fd6KkLJXLa\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-07-31T13:17:37Z\\\",\\\"assetId\\\":\\\"fee4409a61d89dcabbe2624233c663f24526e27e\\\",\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"dYIrNmxuNHNG_Nx]WERj?vIURjWCRin#xuays+xtWBj[\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.75,\\\"height\\\":2560,\\\"width\\\":1920},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#5f3b35\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.43,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#832e3e\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.23,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#8b8274\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":6.79,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#b7c0ce\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":2.38,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#cbdfee\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":6.14,\\\"title\\\":\\\"#000\\\"},\\\