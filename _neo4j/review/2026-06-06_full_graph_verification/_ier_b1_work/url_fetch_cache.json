ba-5436x3564.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F5e92035196abf559dd00a8e9bc92760ae5ef86ba-5436x3564.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F5e92035196abf559dd00a8e9bc92760ae5ef86ba-5436x3564.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F5e92035196abf559dd00a8e9bc92760ae5ef86ba-5436x3564.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F5e92035196abf559dd00a8e9bc92760ae5ef86ba-5436x3564.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75\"/><div class=\" absolute inset-0 flex items-center justify-center group md:opacity-0 hover:opacity-100 duration-300 z-10 cursor-pointer\"><button data-active=\"false\" class=\"pointer-events-none !leading-none uppercase rounded-[40px] border transition-colors duration-200 inline-block text-12 md:text-16 py-[0.2rem] px-[0.5rem] text-white border  hover:bg-white hover:text-black hover:border-white data-[active=true]:bg-white data-[active=true]:text-black data-[active=true]:border-white cursor-pointer\">Show image</button></div></span></div><figcaption class=\"italic text-12 mt-2 [&amp;_mark]:text-primary [&amp;_mark]:bg-transparent\">Copyright: Thom Geraeds</figcaption></figure><h3>Website</h3><p>The focus on sustainability also extends to Thoravej 29’s digital presence, which features an ECO function on the website. We have made a dedicated effort to create a low-impact website that produces approximately 65% less CO₂ per page view than the average website.</p></div></div></div></div><div clas