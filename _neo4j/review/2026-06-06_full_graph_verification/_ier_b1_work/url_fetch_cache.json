\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\", and \\\"},{\\\"_key\\\":\\\"9e67cbd15ed7\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"95394e616984\\\"],\\\"text\\\":\\\"ABC Consulting Engineers\\\"},{\\\"_key\\\":\\\"8d932f8e209a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\", The \\\"},{\\\"_key\\\":\\\"d13d0c35cd23\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"eb6e32bb1a8a\\\"],\\\"text\\\":\\\"Bikuben Foundation\\\"},{\\\"_key\\\":\\\"ea5f506c4081\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" has transformed the former industrial building into spaces and facilities designed to challenge conventional thinking.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"39b4beff148e\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://pihlmann.dk/\\\",\\\"internalLink\\\":null},{\\\"_key\\\":\\\"5d8eb8d79706\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.hoffmann.dk/\\\",\\\"internalLink\\\":null},{\\\"_key\\\":\\\"95394e616984\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://abc.dk/\\\",\\\"internalLink\\\":null},{\\\"_key\\\":\\\"eb6e32bb1a8a\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.thoravej29.dk/da/medlem/bikubenfonden\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"9f7a4ecea639\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"52b7b1abc0db\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"From the outset, there was a strong desire to act as responsibly as possible. The entire renovation was therefore guided by one fundamental principle: the building should reuse itself.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"f718da6017dc\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"11cacc0f3045\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Examples of Reuse in the Construction Process\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"46385d86ce13\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"9241a2696c7d\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The ceiling at Thoravej 29 has been turned into stairs and interior fittings. The old ceiling – a TT deck – was cut and lowered to form a staircase. This transformation brought natural light into the building while reusing the existing concrete elements.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"4052f522c1e9\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"7f983cacf4eb\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Most construction teams would not hesitate to replace plastic windows, but since the plastic windows at Thoravej 29 still have an estimated lifespan of around 15 years, they will only be replaced when necessary. Surplus facade bricks have been reused as flooring, and doors have been shredded and recast into tabletops for the building.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"46bbef56609a\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"8dedffcc29ab\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Figures from DTU – Up to 88% Reduction in CO₂ Emissions\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"c02f394c55b2\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"8899890579d4\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"In connection with the project, Associate Professor Kristoffer Negeldahl from DTU (Technical University of Denmark) carried out an analysis of how the comprehensive reuse principle affected CO₂ emissions compared to new construction.\\\\nThe analysis shows that the renovation of Thoravej 29 achieved:\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"757100effca2\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"2cb969d488b7\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Up to 88% reduction in CO₂ emissions compared to new construction\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"e62bdf6e7e36\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"e6f36d58feed\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"95% reuse of materials\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"0fcda505ca63\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"7d4c08fb8b4a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"90% reduction in waste\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"a25ee829bdc6\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"d0f1d32d794d\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The building received a \\\"},{\\\"_key\\\":\\\"5403a1c7a519\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"4cf3342aaa71\\\"],\\\"text\\\":\\\"DGNB Gold pre-certification\\\"},{\\\"_key\\\":\\\"8e18babc455c\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" from the Green Building Council Denmark in autumn 2023 and was awarded a \\\"},{\\\"_key\\\":\\\"b334a8e4e782\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"4533b1981154\\\"],\\\"text\\\":\\\"Building Award for Building of the Year by \\\"},{\\\"_key\\\":\\\"875dd88b3779\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"em\\\",\\\"4533b1981154\\\"],\\\"text\\\":\\\"Licitationen\\\"},{\\\"_key\\\":\\\"abd6d5ee0b67\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" in autumn 2024.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"4cf3342aaa71\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://rfbb.dk/dgnb?srsltid=AfmBOophwNgVBkGgRYqxzY3xZi9TRYBm-5bNTWZzfLRX0P8CDTDNXPCp\\\",\\\"internalLink\\\":null},{\\\"_key\\\":\\\"4533b1981154\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.licitationen.dk/article/view/1131577/arets_bygning_2024_en_stor_istandsaettelse_af_en_gammel_kommunebygning\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"888b7fd40c11\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"ba57d97a064a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Location, Architects, and Construction Team\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"aa26d5ec35e6\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"248eec08c6fa\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The Bikuben Foundation originally purchased the building in Copenhagen’s Nordvest district to be closer to the people and communities it aims to support and collaborate with on creating positive social change.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"d0e8d638e3d2\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"237fcfbf579e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"From the beginning, the foundation made a conscious decision to engage younger architects for the project. In the initial phase, emerging architectural studios were paired on “speed dates” with experienced contractors and engineers. Ultimately, Pihlmann Architects, Hoffmann A/S, and ABC Consulting Engineers were chosen – forming a team characterized by courage, innovation, and social responsibility.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"465a8334f5f2\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"17e1cbae48db\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Throughout the process, the Bikuben Foundation collaborated with experts in sustainability and construction to guide decision-making, and they involved and listened to future users of the building along the way.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"19af9bcc9c43\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"619cac3fe730\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The Bikuben Foundation’s Initiative\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"627be7ffc430\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"6e87fc43c783\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Thoravej 29 marks a completely new direction in the Bikuben Foundation’s philanthropic work. The physical spaces are designed to inspire, develop, and challenge habitual thinking. The initiative behind the community stems from a belief that bringing people and organizations together can foster new perspectives, knowledge, and learning – and serve as a way to co-create solutions across disciplines, interests, and power structures.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"b31618c4a1db\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"8a05ea72bc23\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"In this way, Thoravej 29 has become a central element in the foundation’s work to create positive societal change.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"headline\\\":\\\"Sustainability\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-05-06T12:43:02Z\\\",\\\"_id\\\":\\\"image-a6c7ab88a2e575f2a49b80433593972c31e787aa-4000x6000-jpg\\\",\\\"_rev\\\":\\\"WSns53MIaqc9Fd6KkLLfQK\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-07-31T13:23:52Z\\\",\\\"altText\\\":\\\"Et nærbillede af et blad, der sidder på et træ, der står i SNART\\\",\\\"assetId\\\":\\\"a6c7ab88a2e575f2a49b80433593972c31e787aa\\\",\\\"creditLine\\\":null,\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"s