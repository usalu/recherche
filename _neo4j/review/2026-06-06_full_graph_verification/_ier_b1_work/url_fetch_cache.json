\":{\\\"_createdAt\\\":\\\"2026-03-17T17:38:45Z\\\",\\\"_id\\\":\\\"8e5bbc7c-d843-439f-8fce-8bedcb0f6039\\\",\\\"_type\\\":\\\"project\\\",\\\"_updatedAt\\\":\\\"2026-05-07T15:56:58Z\\\",\\\"awards\\\":null,\\\"backgroundColor\\\":\\\"#ff653b\\\",\\\"cardImage\\\":{\\\"_id\\\":\\\"image-9743dcddfd6b672f186fb8f0ac209268c9ae86cf-9050x5656-jpg\\\",\\\"_type\\\":\\\"image\\\",\\\"alt\\\":null,\\\"height\\\":5656,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/x91j7tbn/production/9743dcddfd6b672f186fb8f0ac209268c9ae86cf-9050x5656.jpg\\\",\\\"width\\\":9050},\\\"client\\\":\\\"PLP Architecture\\\",\\\"credits\\\":null,\\\"description\\\":[{\\\"_key\\\":\\\"dedc87770a26\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"abbd99fd5f35\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"PLP Architecture’s new London studio at The White Chapel Building is a powerful statement of intent, a working embodiment of the practice’s core values of innovation, sustainability and collaboration. Delivered through a circular fit-out strategy, the 22,850 sq ft space demonstrates a bold new approach to workplace design: one that places people, planet and practicality at the heart of decision-making.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"15c1efbd9764\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"6b29f2704f60\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Unlike conventional fit-outs that start from scratch, PLP’s approach began with what already existed. Every opportunity to reuse, repurpose and extend the life of materials was evaluated. By integrating elements from both their former and new spaces, the team achieved a 75.4% reduction in embodied carbon. 92% of materials from the previous studio were either reused or donated, with a further 7% recycled, saving 175.78 tonnes of CO₂ from landfill.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"dccd24ede3a1\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"cf4021dccb5e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"And this was delivered for just £64 per square foot, 68% less than the cost of a typical London fit-out. Highlights include terrazzo worktops embedded with architectural samples, repurposed marble transformed into new tables, and furniture either restored or rehomed. The result is a vibrant, low-impact, and deeply intentional space. One that reflects PLP’s belief in architecture’s power to drive positive change.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"expertises\\\":[\\\"Interior Design\\\",\\\"Industrial Design\\\",\\\"Sustainability\\\"],\\\"heroImageDesktop\\\":{\\\"_id\\\":\\\"image-9743dcddfd6b672f186fb8f0ac209268c9ae86cf-9050x5656-jpg\\\",\\\"_type\\\":\\\"image\\\",\\\"alt\\\":null,\\\"height\\\":5656,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/x91j7tbn/production/9743dcddfd6b672f186fb8f0ac209268c9ae86cf-9050x5656.jpg\\\",\\\"width\\\":9050},\\\"heroImageMobile\\\":{\\\"_id\\\":\\\"image-9743dcddfd6b672f186fb8f0ac209268c9ae86cf-9050x5656-jpg\\\",\\\"_type\\\":\\\"image\\\",\\\"alt\\\":null,\\\"height\\\":5656,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/x91j7tbn/production/9743dcddfd6b672f186fb8f0ac209268c9ae86cf-9050x5656.jpg\\\",\\\"width\\\":9050},\\\"location\\\":\\\"London, UK\\\",\\\"relatedProjects\\\":[{\\\"_id\\\":\\\"6440f7c0-d197-41a2-90d9-3dd91e23bf23\\\",\\\"cardImage\\\":{\\\"_id\\\":\\\"image-88302a9a9c12dd06f33cb2ce2c51c7de249fdac3-2000x1500-jpg\\\",\\\"_type\\\":\\\"image\\\",\\\"alt\\\":null,\\\"height\\\":1500,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/x91j7tbn/production/88302a9a9c12dd06f33cb2ce2c51c7de249fdac3-2000x1500.jpg\\\",\\\"width\\\":2000},\\\"hoverImage\\\":{\\\"_id\\\":\\\"image-e8a171615738b2