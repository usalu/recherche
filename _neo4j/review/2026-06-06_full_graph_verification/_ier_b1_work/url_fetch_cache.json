\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Thoravej 29 | Sustainability\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Thoravej 29 sets new standards for sustainable architecture through reuse, responsible design, and a community built on co-creation.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Sustainability at Thoravej 29\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Discover how Thoravej 29 combines sustainability, architecture, and community.\\\\nWe aim to think about sustainabiliy in everything from materials and furniture to digital design and social initiatives.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"property\\\":\\\"og:image\\\",\\\"content\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/abe0300a19554545cb0c2b838bae2581efa375d4-1200x627.png?rect=3,0,1194,627\\u0026w=1200\\u0026h=630\\u0026fit=max\\u0026auto=format\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Sustainability at Thoravej 29\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Discover how Thoravej 29 combines sustainability, architecture, and community.\\\\nWe aim to think about sustainabiliy in everything from materials and furniture to digital design and social initiatives.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/abe0300a19554545cb0c2b838bae2581efa375d4-1200x627.png?rect=3,0,1194,627\\u0026w=1200\\u0026h=630\\u0026fit=max\\u0026auto=format\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"name\\\":\\\"next-size-adjust\\\"}]]\\n7:null\\n\"])</script><script>self.__next_f.push([1,\"26