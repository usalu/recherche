                                                                     <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605262_wiewiorra-wwstudio-architecture-plattenpalast-5.jpg\" />\n                                            </div>\n                                        </section>\n                                                                                <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605262_wiewiorra-wwstudio-architecture-plattenpalast-5a.jpg\" />\n                                            </div>\n                                        </section>\n                                                                                <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605262_wiewiorra-wwstudio-architecture-plattenpalast-6a.jpg\" />\n                                            </div>\n                                        </section>\n                                                                                <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605262_wiewiorra-wwstudio-architecture-plattenpalast-6b.jpg\" />\n                                            </div>\n                                        </section>\n                                                                                <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605263_wiewiorra-wwstudio-architecture-plattenpalast-7.jpg\" />\n                                            </div>\n                                        </section>\n                                                                                <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605263_wiewiorra-wwstudio-architecture-plattenpalast-8.jpg\" />\n                                            </div>\n                                        </section>\n                                                                                <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605429_2009_hinze-plattenpalast-big.jpg\" />\n                                            </div>\n                                        </section>\n                                                                                <section class=\"item\">\n                                            <div class=\"carousel-img-wrap\">\n                                                <img width=\"620\" height=\"934\" class=\"attachment-all size-all\" alt=\"\"\n                                                src=\"https://wwstudio.de/storage/project_page_images/1578605429_2009_teriete-plattenpalast-hoch.jpg\" />\n                                            </div>\n                                        </section>\n                                        \n                                    </div><!--End owl-carousel-->\n\n                                </div><!--End blog-unit-gallery-wrap-->\n\n                                <div class=\"title-wrap\">\n                                    <div class=\"title-wrap-con\">\n                                        <h1 class=\"title-wrap-tit\">Plattenpalast</h1>\n                                    </div>\n                                </div>\n\n                            </article><!--End article-->\n\n                        </div><!-- End #content_wrap-->\n\n                    </div><!--End fullwrap-layout-inn-->\n\n                </div><!-- End content_wrap_outer-->\n\n            </div><!--End #content-->\n\n            <div id=\"content\">\n\n                <div class=\"content_wrap_outer fullwrap-layout\">\n\n                    <div class=\"fullwrap-layout-inn\">\n\n                        <div id=\"content_wrap\" class=\"\">\n\n                            <article class=\"ux-portfolio type-ux-portfolio margin-left-right\">\n\n                                <div class=\"row single-gallery-col2 single-gallery-col2-filled\">\n\n                                    <!--Text wrap of Col2 layout-->\n                                    <div class=\"single-col2-text-wrap col-sm-12 col-md-7 sticky_column\">\n\n\n                                        <div class=\"entry\">\n                                            <p style=\"font-size: 17px;\"><p>Der Plattenpalast besteht aus demontierten Großflächenplatten des Plattenbautyps WBS 70 und wurde als Forschungsprojekt der TU Berlin unter der Leitung von Claus Asam vom IEMB in Zusammenarbeit mit dem Berliner Architekturbüro wiewiorra hopp architekten als Prototyp entwickelt.</p>\n<p>Es ist das erste Projekt im Berliner Stadtraum, bei dem alte Plattenbauelemente wieder zu einem neuen Gebäude zusammengefügt wurden. Die Idee der Architekten Anna Hopp und Carsten Wiewiorra wurde bereits mit einem Preis der Berliner veilfach Nachwuchsarchitekten geehrt und veröffentlicht. Der Ausbau erfolgte nach Kriterien des nachhaltigen Bauens und es wurden nur recyclebare, umweltschonende und nachhaltige Baustoffe eingesetzt. Die Scheiben wurden aus dem Palast der Republik entnommen und in dem recycelten Plattenbau in Berlin - Mitte eingebaut.</p>\n<p>Anlässlich von 20 Jahren Mauerfall wurde der Plattenpalast Anfang 2009 als Galerie mit wechselnden Ausstellungen von Installationen, Fotografie, Skulpturen und Malerei eröffnet. 2015 wurde die Galerie zu <span style=\"font-family:'-apple-system', BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;color:#000000;\"><a href=\"https://wwstudio.de/projects/minimalwohnen-im-plattenpalast\">\"Wohnen im Minimalraum\"</a></span><span style=\"font-family:'-apple-system', BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\"> umgebaut. </span><span style=\"font-family:'-apple-system', BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\">Es finden weiterhin ausgewählte Auststellungen statt.</span></p>\n<p>Finanziert wurde die Grundlagenforschung des Projektes aus Bundesforschungsmitteln, privaten Mitteln und Sponsoring von verschiedenen Firmen.</p>\n<p><strong>Gebäudedaten<br></strong>Grundfläche des Gebäudes: 36 m²<br>Höhe des Gebäudes: 5,76 m<br>verwendete Platten WBS 70: 13 Teile<br>Fenster: 12 Scheiben mit Aluminiumrahmen aus dem Palast der Republik</p>\n<p><strong>Historie<br></strong>Juni 2004 Abbruch Spendergebäude der Platten in Berlin-Marzahn<br>Juni 2005 Aufbau in der Forschungshalle TU Berlin<br>Nov 2005 Aufbau in der Wolliner Straße 50 Berlin<br>Dez 2008 Einbau Fenster des Palastes der Republik<br>Jan 2009  Beginn Innenausbau<br>Juni 2009 Eröffnung als Ausstellungsraum<br>Juni 2015 Umbau zu \"Wohnen im Minimalraum\"</p>\n<p><strong>Sponsoren</strong></p>\n<p>Das Projekt wurde großzügig unterstützt von J. und E. Wiewiorra und folgenden Firmen:</p>\n<p>Ausbau:<br>Redstone www.redstone.de<br>weber maxit www.weber-maxit.de<br>Danfoss www.danfoss.de<br>Knauf www.knauf.de<br>Interpane www.interpane.net<br>Jansen www.jansen.com<br><span style=\"font-family:'-apple-system', BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\">Piwarz Licht GmbH www.piwarz.de<br></span>8punkt8 GmbH www.8punkt8.de<br>Berker www.berker.de<br>Sto www.sto.de</p>\n<p>Dach:<br>Enke www.enke-werk.de<br>Rheinzink www.rheinzink.de<br>Martin Böker OHG</p>\n<p>Demontage / Remontage:<br>BMK www.bmk-kran.de<br>S&amp;P www.reinforcement.ch/deutsch.htm<br>Weber Deitermann www.deitermann.de<br>Fischer www.fischer.de<br>Kummer www.kummer-erdbau.de<br>BSW Berlenburger Schaumstoffwerk www.berleburger.de<br>Mahlo Bau GmbH www.mahlobau.de<br>DBS www.dbsgmbh.de<br>Illbruck www.illbruck-sanitaertechnik.com<br>Degussa www.degussa.de</p>\n<p><strong>Auszeichnungen<br></strong>Plattform Nachwuchsarchitekten 2006 (2.Platz)<br>BDA - Preis 2009 Belobigung<br>Auswahl für das Berliner Architekturjahrbuch 2010 und für die Jahresausstellung \"da!\" im Stilwerk Berlin,<br>Ausstellung in der Werkbundgalerie Berlin 2011<br>\"Reduce Reuse Recycle\" - Katalog des Deutschen Pavillons der 13. Internationalen Biennale in Venedig 2012</p>\n<p> </p></p>\n                                            <div class=\"clear\"></div>\n                                        </div><!--End entry-->\n\n                                        <div class=\"entry\">\n                                            <table>\n                                                <tr>\n                                                    <td valign=\"top\">Standort</td>\n                                                    <td class=\"projectData\">Wollinerstr. 50, 10435 Berlin-Mitte</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Baujahr</td>\n                                                    <td class=\"projectData\">2009</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Abriss</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Bauherr</td>\n                                                    <td class=\"projectData\">Carsten Wiewiorra</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Typologie</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Nutzung</td>\n                                                    <td class=\"projectData\">Galerie</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Maßnahme</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Leistung</td>\n                                                    <td class=\"projectData\">LPH 1 - 8</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Entwurfsplanung</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Entwurf</td>\n                                                    <td class=\"projectData\">Carsten Wiewiorra</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Projektleitung</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Mitarbeit</td>\n                                                    <td class=\"projectData\">Rohbau: Anna Krüger, Claus Asam, Claudia Westermann-Stubenazi, Jan Kindereit | Ausbau: Anna Tscherch</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Bauleitung</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Einheiten</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Fläche</td>\n                                                    <td class=\"projectData\">36 qm</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Fotos</td>\n                                                    <td class=\"projectData\">Thorsten Klapsch, Tobias Wille, Hinze, Teriete, whsa</td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">Auszeichnungen</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                                <tr>\n                                                    <td valign=\"top\">3D-Darstellung</td>\n                                                    <td class=\"projectData\"></td>\n                                                </tr>\n                                            </table>\n                                            <br>\n\n                                        </div><!--End entry-->\n                                    </div><!--End single-col2-text-wrap-->\n\n                                    <!--Images wrap of Col2 layout-->\n                                    <di