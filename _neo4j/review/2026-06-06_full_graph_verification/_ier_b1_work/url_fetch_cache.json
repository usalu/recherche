8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                        </span>\n                    </button>\n                </div>\n            </a>\n        </div>\n    </div>\n</div>\n\n\n<main class=\"site-wrapper behind-header\">    <section class=\"hero\">\n        <div class=\"hero__media-wrap\">        <video \n            class=\"hero__media\" \n            preload=\"none\"\n                            muted=\"\"\n                autoplay=\"\"\n                                        loop\n                                                    poster=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/10/2200_06_thumbnail_01-2.jpg?fit=1600%2C954&ssl=1\" \n                        playsinline\n                            src=\"https://hts.uk.com/wp-content/uploads/2024/10/2200_5sec_web_03-1.mp4\"\n                                        width=\"1920\"\n                                        height=\"1080\"\n                    ></video>       \n    </div>\n        <div class=\"hero__text grid-outer\">\n            <div class=\"hero__title grid-inner js-load-in\">\n                                    <small>\n                        Project 2200                    </small>\n                \n                <h1>\n                    Timber Square                </h1>\n            </div>\n\n                            <div class=\"hero__link js-load-in grid-inner\">\n                    <a href=\"https://hts.uk.com/news-views/how-we-made-it-timber-square/\" class=\"button\">\n                        <span class=\"button__text\">\n                            How we made it\n                        </span>\n\n                        <span class=\"button__icon\">\n                            <svg class=\"svg-fill\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9.44827 2.01321L7.98173 3.47975L11.8524 7.35045L1.04289 7.39217L1.03299 9.46824L11.8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                        </span>\n                    </a>\n                </div>\n                    </div>\n    </section>\n\n<section class=\"project-intro\">\n    <div class=\"project-intro__grid grid-outer\">\n                    <div class=\"project-intro__text rich-text js-load-in grid-inner\">\n                <p>A pioneering net zero carbon mixed-use office redevelopment comprising two buildings – an 80% retained former printworks, which has been refurbished and extended, and a 15-storey new building in Southwark’s Bankside area.</p>\n            </div>\n        \n        <div class=\"project-intro__details js-load-in grid-inner\">\n                            <div class=\"project-intro__detail\">\n                    <span>\n                        Location\n                    </span>\n\n                    <span>\n                        London Borough of Southwark                    </span>\n                </div>\n            \n                            <div class=\"project-intro__detail\">\n                    <span>\n                        Client\n                    </span>\n\n                    <span>\n                        Landsec                    </span>\n                </div>\n            \n                            <div class=\"project-intro__detail\">\n                    <span>\n                        Architect\n                    </span>\n\n                    <span>\n                        Bennetts Associates                    </span>\n                </div>\n            \n                            <div class=\"project-intro__detail\">\n                    <span>\n                        Status\n                    </span>\n\n                    <span>\n                        On site                    </span>\n                </div>\n            \n                            <div class=\"project-intro__detail\">\n                    <span>\n                        GIA\n                    </span>\n\n                    <span>\n                        52,026m²\n                    </span>\n                </div>\n            \n                            <div class=\"project-intro__detail\">\n                    <span>\n                        Feature\n                    </span>\n\n                    <nav class=\"project-intro__detail-list\">\n                        <a href=\"https://hts.uk.com/projects/?feature=new-build\">New Build</a><a href=\"https://hts.uk.com/projects/?feature=refurbishment\">Refurbishment</a><a href=\"https://hts.uk.com/projects/?feature=tall-buildings\">Tall Buildings</a>                    </nav>\n                </div>\n                    </div>\n    </div>\n</section>\n    <div class=\"flexible-content flow-xlarge\">\n            <section class=\"impact full-bleed impact--3\" style=\"--color-main: var(--color-ochre); --color-secondary: var(--color-lemon); --color-body: var(--color-white); --color-accent: var(--color-midlemon);\">\n        <div class=\"impact-grid grid-outer js-carousel\" data-draggable=\"true\" data-set-fullheight=\"true\">\n                <div class=\"stat grid-inner js-load-in\">\n                    <h3>\n                Structural embodied carbon             </h3>\n        \n        <div class=\"stat__main\">\n                            <h2>\n                    <p>205</p>\n                </h2>\n            \n                            <h3>\n                    <p>kgCO<sub>2</sub>e/m²</p>\n                </h3>\n                    </div>\n    </div>\n    <div class=\"bar-chart grid-inner\">\n                    <h3 class=\"js-load-in\">\n                Embodied carbon saved            </h3>\n        \n        <div class=\"bar-chart__rows js-load-in\">\n                            <div class=\"bar-chart__row\">\n                                            <div class=\"bar-chart__value\" style=\"--width: 100%;\">\n                            <div class=\"bar-chart__bar\"></div>\n\n                                                            <span class=\"bar-chart__amount\">\n                                    5300                                </span>\n                                                    </div>\n                    \n                                            <span class=\"bar-chart__label\">\n                            Tonnes of embodied carbon stored by timber                        </span>\n                                    </div>\n                            <div class=\"bar-chart__row\">\n                                            <div class=\"bar-chart__value\" style=\"--width: 25%;\">\n                            <div class=\"bar-chart__bar\"></div>\n\n                                                            <span class=\"bar-chart__amount\">\n                                    216                                </span>\n                                                    </div>\n                    \n                                            <span class=\"bar-chart__label\">\n                            Tonnes of embodied carbon saved by reused steel                        </span>\n                                    </div>\n                    </div>\n    </div>\n    <div class=\"circle-chart grid-inner\">\n                    <h3 class=\"js-load-in\">\n                80% of the existing Print Building retained            </h3>\n        \n        <div class=\"circle-chart__graph\">\n            <span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle circle--highlight js-load-in\"></span><span class=\"circle js-load-in\"></span><span class=\"circle js-load-in\"></span><span class=\"circle js-load-in\"></span><span class=\"circle js-load-in\"></span>        </div>\n\n                    <div class=\"circle-chart__footer js-load-in\">\n                                    <p class=\"circle-chart__label\">\n                        <span class=\"circle circle--highlight\"></span>\n                        = Structure retained                    </p>\n                \n                                    <p class=\"circle-chart__total\">\n                        <span class=\"circle\"></span>\n                        = Structure demolished                     </p>\n                            </div>\n            </div>\n        </div>\n\n                    <div class=\"impact-nav\" data-carousel-nav=\"impact\">\n                <button class=\"carousel-prev js-carousel-prev disable\">\n                    <span class=\"visually-hidden\">Previous</span>\n                    <svg class=\"svg-fill\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9.44827 2.01321L7.98173 3.47975L11.8524 7.35045L1.04289 7.39217L1.03299 9.46824L11.8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                </button>\n                \n                <button class=\"carousel-next js-carousel-next\">\n                    <span class=\"visually-hidden\">Next</span>\n                    <svg class=\"svg-fill\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9.44827 2.01321L7.98173 3.47975L11.8524 7.35045L1.04289 7.39217L1.03299 9.46824L11.8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                </button>\n            </div>\n        \n        <div class=\"impact-link grid-outer\">\n            <a href=\"https://hts.uk.com/how-we-measure-impact/\" class=\"grid-inner js-load-in\">\n                How we measure impact\n            </a>\n        </div>\n    </section>\n    <div class=\"key-features grid-outer\">\n            <div class=\"accordions grid-inner js-accordion-group\">\n        <h2 class=\"js-load-in\">Key features</h2>            <details class=\"accordion js-load-in js-accordion\" data-accordion-id=\"1\">\n                <summary>\n                    <span class=\"accordion__icon\">\n                        <svg class=\"svg-plus-circle\" width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path class=\"circle\" d=\"M13 26C20.1797 26 26 20.1797 26 13C26 5.8203 20.1797 0 13 0C5.8203 0 0 5.8203 0 13C0 20.1797 5.8203 26 13 26Z\"/>\n    <path class=\"svg-stroke horizontal\" d=\"M18.98 13.1069H7.09798\" stroke-width=\"2\"/>\n    <path class=\"svg-stroke vertical\" d=\"M13.0391 7.16504V19.047\" stroke-width=\"2\"/>\n</svg>\n                    </span>\n\n                    <span class=\"accordion__title\">\n                        80% retention of 1950s structure                    </span>\n                </summary>\n\n                <div class=\"accordion__content flow-medium rich-text js-accordion-content\">\n                    <p>The 1950s printworks building was retained and extended by six storeys, with minimal strengthening to the frame and foundations.</p>\n                </div>\n            </details>\n                    <details class=\"accordion js-load-in js-accordion\" data-accordion-id=\"2\">\n                <summary>\n                    <span class=\"accordion__icon\">\n                        <svg class=\"svg-plus-circle\" width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path class=\"circle\" d=\"M13 26C20.1797 26 26 20.1797 26 13C26 5.8203 20.1797 0 13 0C5.8203 0 0 5.8203 0 13C0 20.1797 5.8203 26 13 26Z\"/>\n    <path class=\"svg-stroke horizontal\" d=\"M18.98 13.1069H7.09798\" stroke-width=\"2\"/>\n    <path class=\"svg-stroke vertical\" d=\"M13.0391 7.16504V19.047\" stroke-width=\"2\"/>\n</svg>\n                    </span>\n\n                    <span class=\"accordion__title\">\n                        Hybrid CLT and steel structure                     </span>\n                </summary>\n\n                <div class=\"accordion__content flow-medium rich-text js-accordion-content\">\n                    <p>The hybrid structure reduces embodied carbon by 30% when compared to typical comparable new builds.</p>\n                </div>\n            </details>\n                    <details class=\"accordion js-load-in js-accordion\" data-accordion-id=\"3\">\n                <summary>\n                    <span class=\"accordion__icon\">\n                        <svg class=\"svg-plus-circle\" width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path class=\"circle\" d=\"M13 26C20.1797 26 26 20.1797 26 13C26 5.8203 20.1797 0 13 0C5.8203 0 0 5.8203 0 13C0 20.1797 5.8203 26 13 26Z\"/>\n    <path class=\"svg-stroke horizontal\" d=\"M18.98 13.1069H7.09798\" stroke-width=\"2\"/>\n    <path class=\"svg-stroke vertical\" d=\"M13.0391 7.16504V19.047\" stroke-width=\"2\"/>\n</svg>\n                    </span>\n\n                    <span class=\"accordion__title\">\n                        Kit-of-parts superstructure enables flexibility                    </span>\n                </summary>\n\n                <div class=\"accordion__content flow-medium rich-text js-accordion-content\">\n                    <p>The kit-of-parts approach with minimal element types reduces the site programme and allows future flexibility with removable floor panels.</p>\n                </div>\n            </details>\n                    <details class=\"accordion js-load-in js-accordion\" data-accordion-id=\"4\">\n                <summary>\n                    <span class=\"accordion__icon\">\n                        <svg class=\"svg-plus-circle\" width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path class=\"circle\" d=\"M13 26C20.1797 26 26 20.1797 26 13C26 5.8203 20.1797 0 13 0C5.8203 0 0 5.8203 0 13C0 20.1797 5.8203 26 13 26Z\"/>\n    <path class=\"svg-stroke horizontal\" d=\"M18.98 13.1069H7.09798\" stroke-width=\"2\"/>\n    <path class=\"svg-stroke vertical\" d=\"M13.0391 7.16504V19.047\" stroke-width=\"2\"/>\n</svg>\n                    </span>\n\n                    <span class=\"accordion__title\">\n                        15-storey new build                    </span>\n                </summary>\n\n                <div class=\"accordion__content flow-medium rich-text js-accordion-content\">\n                    <p>The 15-storey new build element includes a new double basement and piled raft foundations.</p>\n                </div>\n            </details>\n                    <details class=\"accordion js-load-in js-accordion\" data-accordion-id=\"5\">\n                <summary>\n                    <span class=\"accordion__icon\">\n                        <svg class=\"svg-plus-circle\" width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path class=\"circle\" d=\"M13 26C20.1797 26 26 20.1797 26 13C26 5.8203 20.1797 0 13 0C5.8203 0 0 5.8203 0 13C0 20.1797 5.8203 26 13 26Z\"/>\n    <path class=\"svg-stroke horizontal\" d=\"M18.98 13.1069H7.09798\" stroke-width=\"2\"/>\n    <path class=\"svg-stroke vertical\" d=\"M13.0391 7.16504V19.047\" stroke-width=\"2\"/>\n</svg>\n                    </span>\n\n                    <span class=\"accordion__title\">\n                        New public realm space and SuDS                    </span>\n                </summary>\n\n                <div class=\"accordion__content flow-medium rich-text js-accordion-content\">\n                    <p>Provision of new public realm space incorporating raingardens and a blue roof above the podium deck. </p>\n                </div>\n            </details>\n            </div>\n\n    <div class=\"accordions-media grid-inner js-accordion-media js-load-in\">\n        <div class=\"accordions-media__mask\">\n                            <div class=\"accordions-media__wrap active js-accordion-media-wrap\" data-accordion-id=\"1\">\n                            \n        <picture \n            class=\"  js-lightbox-toggle\"\n             data-lightbox-toggle=\"1\"        >\n                            <source \n                    type=\"image/jpeg\"\n                    srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/10/2200_05_220106_15.jpg?w=2000&amp;ssl=1 2000w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/10/2200_05_220106_15.jpg?resize=600%2C450&amp;ssl=1 600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/10/2200_05_220106_15.jpg?resize=1024%2C768&amp;ssl=1 1024w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/10/2200_05_220106_15.jpg?resize=1600%2C1200&amp;ssl=1 1600w\"\n                    sizes=\"(min-width: 1200px) 100vw,\n              (min-width: 601px) 100vw,\n              (max-width: 600px) 100vw\">\n                        \n            <source \n                type=\"image/jpeg\"\n                srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/10/2200_05_220106_15.jpg?w=2000&amp;ssl=1 2000w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/10/2200_05_220106_15.jpg?resize=600%2C450&amp;ssl=1 600w, https://i0.wp.com/hts.uk.com/wp-content/upload