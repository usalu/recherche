xt\\\":\\\"Sara Martinsen\\\"},{\\\"_key\\\":\\\"80afe58d2e89\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" as the main advisor on materials and furnishings, in close collaboration with Pihlmann Architects.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"558696c71693\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.saramartinsen.com/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"1c226c7d8202\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"37814aaa9378\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Examples of Reused Materials from the Existing Building\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"7c608e7b9774\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"b78e280db00b\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Wood\\\"},{\\\"_key\\\":\\\"2b25cb61716a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"\\\\nMaterials from the original building were sent to the company \\\"},{\\\"_key\\\":\\\"134cd3d35546\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"c77b6a8ae6ec\\\"],\\\"text\\\":\\\"Convert \\\"},{\\\"_key\\\":\\\"c4d68946c01a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"in Jutland. All wooden products – doors, floors, and door frames – were shredded and pressed into new boards. These boards were then used to produce meeting tables, coffee tables, benches, and shelving units.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"c77b6a8ae6ec\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://convert.as/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"24b347b88bf5\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Hampus Berndtson\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T10:21:46Z\\\",\\\"_id\\\":\\\"image-e7fb58b08474cbbfea0c1d0e4662e9d4433dc