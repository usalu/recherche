34;:false,&#34;important&#34;:false,&#34;stay&#34;:false,&#34;stayAndShowInMobileMenu&#34;:false,&#34;items&#34;:[]}]}]\" user-specific-metanav-items-endpoint=\"/stzh/myaccount/user-metanav-items.json?lang=de\" href=\"/de.html\" search-action=\"/de/service/suche.html\" logo-type=\"default\">\n        <img slot=\"logo\" src=\"/content/dam/corporate-design/de/logos/stadt-zuerich.svg\" alt=\"Stadt Zürich – Zur Startseite\"/>\n    </stzh-header>\n</div>\n\n    <main id=\"anchorContent\">\n        <stzh-container id=\"content\">\n            \n\n            <div class=\"section has-pagetitle\">\n    <stzh-cspace remove-first-margin=\"false\" remove-last-margin=\"true\">\n        \n        \n\n\n\n        <!-- RSPEAK_STOP -->\n        <!-- RSPEAK_STOP -->\n<stzh-breadcrumb items=\"[{&#34;label&#34;:&#34;Deutsch&#34;,&#34;href&#34;:&#34;/de.html&#34;},{&#34;label&#34;:&#34;Planen &amp; Bauen&#34;,&#34;href&#34;:&#34;/de/planen-und-bauen.html&#34;},{&#34;label&#34;:&#34;Projekte &amp; Ausschreibungen&#34;,&#34;href&#34;:&#34;/de/planen-und-bauen/projekte-und-ausschreibungen.html&#34;},{&#34;label&#34;:&#34;Hochbauvorhaben&#34;,&#34;href&#34;:&#34;/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben.html&#34;},{&#34;label&#34;:&#34;Laufende Hochbauprojekte&#34;,&#34;href&#34;:&#34;/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben/planung-ausfuehrung.html&#34;},{&#34;label&#34;:&#34;Recyclingzentrum Juch-Areal&#34;}]\"></stzh-breadcrumb>\n<!-- RSPEAK_START -->\n\n        <!-- RSPEAK_START -->\n        <stzh-pagetitle>\n\n    \n\n    <!-- RSPEAK_STOP -->\n    <stzh-readspeaker slot=\"readspeaker\" href=\"https://app-eu.readspeaker.com/cgi-bin/rsent?customerid=4490&amp;lang=de_de&amp;readid=content&amp;url=https://www.stadt-zuerich.ch/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben/planung-ausfuehrung/recyclingzentrum-juch-areal.html\">\n        <stzh-button>\n            Seite vorlesen\n        </stzh-button>\n    </stzh-readspeaker>\n    <!-- RSPEAK_START -->                                                                        \n    <stzh-heading slot=\"heading\">Neubau Recyclingzentrum Juch-Areal</stzh-heading>\n    <img slot=\"image\" src=\"https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-01?qlt=85&wid=2001&fmt=webp-alpha\" loading=\"eager\" alt=\"Die Visualisierung des geplanten Bauvorhabens zeigt einen Blick in die Halle der Werkstoffsammelstelle.\"/>\n    \n    <stzh-text slot=\"lead\">\n        Das Recyclingzentrum Juch-Areal von Entsorgung + Recycling Zürich ist ein Pionierprojekt für die Wiederverwendung von Bauteilen und die Reduktion von Treibhausgasemissionen.\n    </stzh-text>\n\n    \n    \n\n\n\n\n</stzh-pagetitle>\n\n    </stzh-cspace>\n</div>\n\n            \n<stzh-pagecontent data-stzh-sticky-container>\n    <div slot=\"anchornav\">\n        <stzh-anchornav items=\"[{&#34;label&#34;:&#34;Re-Use als Beitrag zur Reduktion von Treibhausgasemissionen&#34;,&#34;href&#34;:&#34;#re-use_als_beitragzurreduktionvontreibhausgasemissionen&#34;},{&#34;label&#34;:&#34;Re-Use in den frühen Planungsphasen&#34;,&#34;href&#34;:&#34;#re-use_in_den_fruehenplanungsphasen&#34;},{&#34;label&#34;:&#34;Materialkreisläufe erhalten&#34;,&#34;href&#34;:&#34;#materialkreislaeufeerhalten&#34;},{&#34;label&#34;:&#34;Mehr als ein Recyclinghof&#34;,&#34;href&#34;:&#34;#mehr_als_ein_recyclinghof&#34;},{&#34;label&#34;:&#34;Thematische Vertiefung&#34;,&#34;href&#34;:&#34;#thematische_vertiefung&#34;},{&#34;label&#34;:&#34;Fachstudien zum kreislauforientierten Bauen&#34;,&#34;href&#34;:&#34;#fachstudien_zum_kreislauforientiertenbauen&#34;},{&#34;label&#34;:&#34;Standort&#34;,&#34;href&#34;:&#34;#standort&#34;}]\"></stzh-anchornav>\n</div>\n\n\n\n    \n    <div class=\"mainparsys parsys\"><div class=\"has-textandimage section\">\n    \n        <stzh-section padding-bottom=\"default\" padding-top=\"default\">\n            <stzh-content>\n                <stzh-cspace>\n                    \n                    \n\n                    <stzh-textandimage size=\"small\">\n                        <div slot=\"left\">\n                            <stzh-richtext><p>Der geplante Neubau des Recyclingzentrums Juch-Areal von Entsorgung + Recycling Zürich (ERZ) in Zürich-Altstetten steht im Zeichen der Strategie <a href=\"/web/de/umwelt-und-energie/klima/kreislaufwirtschaft/massnahmen.html\" class=\"icon intern\">«Circular Zürich»</a> zur Kreislaufwirtschaft und soll ein Sinnbild der Wiederverwendung von (Bau-)Materialien sein. Das Amt für Hochbauten Stadt Zürich will beim Pilotprojekt Recyclingzentrum Juch-Areal gemeinsam mit Entsorgung + Recycling Zürich und dem Planungsteam das Potenzial des zirkulären Bauens mit Re-Use-Bauteilen zur Reduktion der Treibhausgasemissionen bei öffentlichen Bauten maximal ausloten.</p>\n</stzh-richtext>\n                        </div>\n                        \n                    </stzh-textandimage>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n\n</div>\n\n</div>\n<div class=\"mainparsys parsys\"><div class=\"has-youtube section\">\n    \n        <stzh-section>\n            <stzh-content>\n                <stzh-cspace>\n                    \n\n                    <stzh-figure caption=\"Erfahren Sie im Video mehr über Re-Use als Beitrag zur Kreislaufwirtschaft beim Bauen.\">\n                        <stzh-youtube url='https://www.youtube.com/embed/omEP5Y7cELY' id=\"youtube\">\n                            <img slot=\"preview-image\" src=\"/content/web/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben/planung-ausfuehrung/recyclingzentrum-juch-areal/_jcr_content/mainparsys/youtube/previewImage.1024.567.jpg/1774454681359.jpg\" loading=\"lazy\" alt/>\n                            \n                        </stzh-youtube>\n                    </stzh-figure>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n</div>\n<div class=\"has-accordion section\"><stzh-section padding-bottom=\"default\" padding-top=\"default\">\n    <stzh-content>\n        <stzh-cspace>\n            \n            <stzh-accordion>\n                    <div class=\"accordionitem section\">\n    <stzh-accordion-item heading=\"Verantwortlichkeiten und Eckdaten\" open=\"true\">\n        <stzh-cspace><div class=\"has-textandimage section\">\n    \n        <stzh-section padding-bottom=\"default\" padding-top=\"default\">\n            <stzh-content>\n                <stzh-cspace>\n                    \n                    \n\n                    <stzh-textandimage size=\"small\">\n                        <div slot=\"left\">\n                            <stzh-richtext><ul>\n<li><strong>Bauherrschaft </strong>Stadt Zürich</li>\n<li><strong>Eigentümervertretung </strong>Entsorgung + Recycling Zürich (ERZ)</li>\n<li><strong>Bauherrenvertretung </strong>Amt für Hochbauten</li>\n<li><strong>Generalplanung und Architektur </strong>Graber Pulver Architekt:innen AG, Zürich</li>\n<li><strong>Baumanagement</strong> Perita AG, Basel</li>\n<li><strong>Bauingenieurwesen </strong>Weber + Brönnimann AG, Bern</li>\n<li><strong>Fachplanung Kreislaufbauen</strong> Zirkular GmbH, Basel</li>\n<li><strong>Auswahlverfahren </strong>Architekturwettbewerb im selektiven Verfahren nach SIA 142 mit 10 Teams (einstufig, anonym), März 2023</li>\n<li><strong>Politischer Prozess </strong>Vorlage zum Ausführungskredit von Stadt- und Gemeinderat angenommen. Volksabstimmung: Juni 2026</li>\n<li><strong>Ausführungskredit </strong>CHF 33,1 Mio.</li>\n<li><strong>Bauzeit</strong> 2026–2027</li>\n</ul>\n</stzh-richtext>\n                        </div>\n                        \n                    </stzh-textandimage>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n\n</div>\n\n</stzh-cspace>\n    </stzh-accordion-item>\n\n\n\n    \n\n</div>\n\n\n            </stzh-accordion>\n        </stzh-cspace>\n    </stzh-content>\n</stzh-section></div>\n<div class=\"has-textandimage section\">\n    \n        <stzh-section padding-bottom=\"default\" padding-top=\"default\">\n            <stzh-content>\n                <stzh-cspace>\n                    \n    <stzh-heading level=\"2\" id=\"re-use_als_beitragzurreduktionvontreibhausgasemissionen\">Re-Use als Beitrag zur Reduktion von Treibhausgasemissionen</stzh-heading>\n\n                    \n\n                    <stzh-textandimage size=\"default\">\n                        <div slot=\"left\">\n                            <stzh-richtext><p>Vergleicht man die Treibhausgasbilanz der Erstellung des Recyclingzentrums Juch-Areal aus Re-Use-Bauteilen mit einem konventionellen Neubau aus neu produzierten Bauteilen lässt sich eine Einsparung von fast 600 Tonnen CO<sub>2</sub> erzielen. Dies entspricht einer Reduktion von gut 40 Prozent. Vor allem wenn tragende Re-Use-Bauteile aus Beton oder Stahl zum Einsatz kommen, die in der Neuproduktion sehr energieintensiv sind, ist die Wiederverwendung von Bauteilen eine äusserst wirksame Massnahme zur Reduktion der indirekten Treibhausgasemissionen.</p>\n</stzh-richtext>\n                        </div>\n                        \n                    </stzh-textandimage>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n\n</div>\n<div class=\"has-textandimage section\">\n    \n        <stzh-section padding-bottom=\"default\" padding-top=\"default\">\n            <stzh-content>\n                <stzh-cspace>\n                    \n    <stzh-heading level=\"2\" id=\"re-use_in_den_fruehenplanungsphasen\">Re-Use in den frühen Planungsphasen</stzh-heading>\n\n                    \n\n                    <stzh-textandimage size=\"default\">\n                        <div slot=\"left\">\n                            <stzh-richtext><p>Das Planen und Bauen mit Re-Use-Bauteilen verlangt ein Umdenken bei der Bauherrschaft, bei Planenden und Unternehmen. Re-Use ist ein Gemeinschaftswerk und gelingt nur im Miteinander: Konventionelle Abläufe in Planung und Bau müssen hin zu einem iterativen Prozess angepasst, Unsicherheiten gemanagt und die rechtlichen Rahmenbedingungen geklärt werden.</p>\n<p>Betrachtet man die frühen Planungsphasen ist es wichtig, dass Re-Use bereits mitgedacht wird. Ein entsprechendes Budget muss für die frühe Beschaffung von Schlüsselbauteilen verfügbar sein, um diese Bauteile frühzeitig zu sichern. Ein wichtiger Meilenstein war die Ausschreibung des ersten öffentlichen Re-Use-Architekturwettbewerbs. Gemeinsam mit den Spezialist*innen für das kreislauforientierte Bauen von Zirkular wurden bereits vor dem Wettbewerbsstart Bauteile evaluiert, in einem digitalen Bauteilekatalog aufgelistet und den Teilnehmenden am Architekturwettbewerb zur Verfügung gestellt. Dies mit dem Ziel, das Projekt konsequent an der Verfügbarkeit real existierender Bauteile auszurichten.</p>\n</stzh-richtext>\n                        </div>\n                        \n                    </stzh-textandimage>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n\n</div>\n<div class=\"imagegallery section\">\n    <stzh-section padding-bottom=\"default\">\n        <script>\n            {\n                let breadcrumbsUpdated = false;\n                window.addEventListener('appload', () => {\n                    const existingBcJson = document.querySelector('stzh-breadcrumb').items;\n                    if (!existingBcJson || breadcrumbsUpdated) {\n                        return;\n                    }\n                    const breadcrumbItems = JSON.parse(existingBcJson);\n                    const galleriesJson = '[{\"label\":\"\",\"href\":\"/content/web/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben/planung-ausfuehrung/recyclingzentrum-juch-areal.html?path=/content/web/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben/planung-ausfuehrung/recyclingzentrum-juch-areal/jcr:content/mainparsys/imagegallery\"}]';\n                    const galleries = JSON.parse(galleriesJson);\n                    if (galleries.length > 0) {\n                        breadcrumbItems[breadcrumbItems.length - 1].href = galleries[0].href;\n                        breadcrumbItems.push(...galleries.slice(1));\n                        document.querySelector('stzh-breadcrumb').items = JSON.stringify(breadcrumbItems);\n                    }\n                    breadcrumbsUpdated = true;\n                });\n\n                let lightboxOpened = false;\n                window.addEventListener('appload', () => {\n                    if (lightboxOpened) {\n                        return;\n                    }\n                    const params = new URLSearchParams(window.location.search);\n                    const gid = params.get('gid');\n                    const pid = params.get('pid');\n                    if (gid && pid) {\n                        const gallery = document.querySelector('stzh-gallery[id=\"' + gid + '\"]');\n                        const imagesJSON = gallery ? gallery.getAttribute('images') : '[]';\n                        let images = [];\n                        try {\n                            images = JSON.parse(imagesJSON);\n                        } catch (e) {\n                            console.error('Error parsing stzh-gallery.images JSON', e);\n                        }\n                        if (images.length > 0) {\n                            const imageIdx = images.findIndex((e) => e.srcLightbox.endsWith('/' + pid));\n                            if (imageIdx > -1) {\n                                gallery.openLightbox(imageIdx);\n                                lightboxOpened = true;\n                            }\n                        }\n                    }\n                });\n            }\n        </script>\n        <stzh-content>\n            <stzh-cspace>\n                \n                \n                \n\n                \n\n                <stzh-gallery id=\"visualisierungen-plaene\" variant=\"carousel\" show-items=\"4\" step-items=\"4\" images=\"[{&#34;heading&#34;:&#34;Visualisierung Recyclinghalle (Visualisierung: Graber Pulver Architekt:innen / maaars visualisierungen)&#34;,&#34;captionLightbox&#34;:&#34;&#34;,&#34;src&#34;:&#34;https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-02&#34;,&#34;copyright&#34;:&#34;&#34;,&#34;width&#34;:1260,&#34;height&#34;:839},{&#34;heading&#34;:&#34;Visualisierung Betriebsgebäude (Visualisierung: Graber Pulver Architekt:innen / maaars visualisierungen)&#34;,&#34;captionLightbox&#34;:&#34;&#34;,&#34;src&#34;:&#34;https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-03&#34;,&#34;copyright&#34;:&#34;&#34;,&#34;width&#34;:1260,&#34;height&#34;:839},{&#34;heading&#34;:&#34;Visualisierung Werkstatt Betriebsgebäude (Visualisierung: Graber Pulver Architekt:innen / maaars visualisierungen)&#34;,&#34;captionLightbox&#34;:&#34;&#34;,&#34;src&#34;:&#34;https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-04&#34;,&#34;copyright&#34;:&#34;&#34;,&#34;width&#34;:1260,&#34;height&#34;:839},{&#34;heading&#34;:&#34;Tragstruktur aus wiederverwendeten Stahl- und Betonteilen (Axonometrie: Graber Pulver Architekt:innen)&#34;,&#34;captionLightbox&#34;:&#34;&#34;,&#34;src&#34;:&#34;https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-05&#34;,&#34;copyright&#34;:&#34;&#34;,&#34;width&#34;:1260,&#34;height&#34;:839},{&#34;heading&#34;:&#34;Querschnitte und Ansichten (Pläne: Graber Pulver Architekt:innen)&#34;,&#34;captionLightbox&#34;:&#34;&#34;,&#34;src&#34;:&#34;https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-06&#34;,&#34;copyright&#34;:&#34;&#34;,&#34;width&#34;:1260,&#34;height&#34;:840},{&#34;heading&#34;:&#34;Grundriss Erdgeschoss (Plan: Graber Pulver Architekt:innen)&#34;,&#34;captionLightbox&#34;:&#34;&#34;,&#34;src&#34;:&#34;https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-07&#34;,&#34;copyright&#34;:&#34;&#34;,&#34;width&#34;:1260,&#34;height&#34;:840},{&#34;heading&#34;:&#34;Situation (Plan: Graber Pulver Architekt:innen)&#34;,&#34;captionLightbox&#34;:&#34;&#34;,&#34;src&#34;:&#34;https://s7g10.scene7.com/is/image/zuerich/recyclingzentrum-juch-areal-08&#34;,&#34;copyright&#34;:&#34;&#34;,&#34;width&#34;:1260,&#34;height&#34;:840}]\"></stzh-gallery>\n            </stzh-cspace>\n        </stzh-content>\n    </stzh-section>\n\n    \n    \n\n\n</div>\n<div class=\"has-textandimage section\">\n    \n        <stzh-section padding-bottom=\"default\" padding-top=\"default\">\n            <stzh-content>\n                <stzh-cspace>\n                    \n    <stzh-heading level=\"2\" id=\"materialkreislaeufeerhalten\">Materialkreisläufe erhalten</stzh-heading>\n\n                    \n\n                    <stzh-textandimage size=\"default\">\n                        <div slot=\"left\">\n                            <stzh-richtext><p>Da der grösste Hebel zur Reduktion der Treibhausgasemissionen im Tragwerk liegt, wird auch die Stahlstruktur der ehemaligen städtischen Recyclinghalle Hagenholz beim Neubau wiederverwendet. Die einzelnen Hallenbauteile wurden beschriftet, sorgfältig demontiert und auf einem Areal von ERZ eingelagert, bis die Halle am neuen Standort wieder 1:1 aufgebaut werden kann. Im Verlauf der Planung konnten zudem gut erhaltene Pilzstützen aus Beton aus einem Abbruchgebäude gewonnen werden. Nebst Re-Use-Leitplanken an der Fassade sollen im Projekt auch Betonplatten aus dem Kerenzerbergtunnel wiederverwendet werden. Sämtliche Bauteile wurden durch Spezialisten auf ihre Eignung geprüft und die rechtlichen Rahmenbedingungen für die Wiederverwendung geklärt.</p>\n<p>Um den Materialkreislauf auch in Zukunft zu gewährleisten, wird der Bau so geplant, dass die Bauteile auch künftig wiederverwendet werden können (Design for Disassembly). Zudem sorgt der Einsatz eines digitalen Bauwerks-Informations-Modells (Building Information Modelling BIM) bei der Umsetzung des Bauvorhabens für ein durchgängiges digitales Daten- und Informationsmanagement, das effiziente Prozesse ermöglicht.</p>\n</stzh-richtext>\n                        </div>\n                        \n                    </stzh-textandimage>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n\n</div>\n<div class=\"has-textandimage section\">\n    \n        <stzh-section padding-bottom=\"default\" padding-top=\"default\">\n            <stzh-content>\n                <stzh-cspace>\n                    \n    <stzh-heading level=\"2\" id=\"mehr_als_ein_recyclinghof\">Mehr als ein Recyclinghof</stzh-heading>\n\n                    \n\n                    <stzh-textandimage size=\"default\">\n                        <div slot=\"left\">\n                            <stzh-richtext><p>Beim Projekt von Graber Pulver Architekt:innen zeigt sich, dass das Bauen mit Re-Use-Bauteilen keine Einschränkung, sondern eine Bereicherung darstellt. Das neue Recyclingzentrum besteht aus einem überdachten Aussenbereich, bei dem die ehemalige Recyclinghalle Hagenholz 1:1 zum Einsatz kommt und wieder aufgebaut werden soll. Ergänzt wird der Bau durch ein dreigeschossiges, beheiztes Betriebsgebäude, das mit Re-Use-Betonpilzstützen als tragende Elemente ausgestattet ist. Unter dem Dach der Recyclinghalle befinden sich die Kundenparkplätze sowie die Grossmulden für das Recycling. Im Verlauf des Vorprojekts wurde ein zusätzliches Geschoss in der Halle ergänzt, um so einen effizienteren und sichereren Betriebsablauf zu ermöglichen. Die angrenzende Lagerhalle beherbergt einen Werkplatz, Lagerflächen und eine Recyclingstelle für Velofahrende und Fussgänger*innen.</p>\n<h4>Pilotbetrieb Josy</h4>\n<p>Zum künftigen kreislauforientierten Betrieb im Recyclingzentrum Juch-Areal läuft bereits heute ein Pilotprojekt als Zwischennutzung auf dem Josef-Areal. Im <a href=\"/artikel/de/josy-kreislaufwirtschaft.html\" class=\"icon extern\">Josy</a> können gut erhaltene Alltagsgegenstände gratis weitergegeben oder mitgenommen werden. Statt Dinge wegzuwerfen oder neu zu beschaffen, wird dort gezeigt, wie Dinge mit reparieren, teilen oder weitergeben zur Schonung von Ressourcen und Klima länger nutzbar bleiben.</p>\n</stzh-richtext>\n                        </div>\n                        \n                    </stzh-textandimage>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n\n</div>\n<div class=\"teaser section\">\n    \n        <stzh-section>\n            <stzh-content variant=\"full\">\n                <stzh-cspace>\n                    \n                    \n    <stzh-heading level=\"2\" id=\"thematische_vertiefung\">Thematische Vertiefung</stzh-heading>\n\n\n                    \n                    \n\n                    \n                    \n    <stzh-search id=\"teaser_copy\" limit=\"4\" api=\"/stzh/search\" variant=\"teaser\" initial-fetch hide-main-filters hide-aside-filters autofetch-main-filters hyphens-enabled>\n        <input type=\"hidden\" name=\"lang\" value=\"de\"/>\n        <input type=\"hidden\" name=\"compResource\" value=\"/content/web/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben/planung-ausfuehrung/recyclingzentrum-juch-areal/jcr:content/mainparsys/teaser_copy\"/>\n        \n    </stzh-search>\n\n\n                    \n                    <stzh-vspace curve=\"medium\" around>\n                        \n                    </stzh-vspace>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n    \n\n</div>\n<div class=\"teaser section\">\n    \n        <stzh-section>\n            <stzh-content variant=\"full\">\n                <stzh-cspace>\n                    \n                    \n    <stzh-heading level=\"2\" id=\"fachstudien_zum_kreislauforientiertenbauen\">Fachstudien zum kreislauforientierten Bauen</stzh-heading>\n\n\n                    \n                    \n\n                    \n                    \n    <stzh-search id=\"teaser_copy_copycop1891498859\" limit=\"3\" api=\"/stzh/search\" variant=\"teaser\" initial-fetch hide-main-filters hide-aside-filters autofetch-main-filters hyphens-enabled>\n        <input type=\"hidden\" name=\"lang\" value=\"de\"/>\n        <input type=\"hidden\" name=\"compResource\" value=\"/content/web/de/planen-und-bauen/projekte-und-ausschreibungen/hochbauvorhaben/planung-ausfuehrung/recyclingzentrum-juch-areal/jcr:content/mainparsys/teaser_copy_copy_cop_1891498859\"/>\n        \n    </stzh-search>\n\n\n                    \n                    <stzh-vspace curve=\"medium\" around>\n                        \n    <stzh-link href=\"/de/planen-und-bauen/stadtplanung/planen-bauen-netto-null/fachstudien.html\">Weitere Fachstudien</stzh-link>\n\n                    </stzh-vspace>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n    \n\n</div>\n<div class=\"has-accordion section\"><stzh-section padding-bottom=\"default\" padding-top=\"default\">\n    <stzh-content>\n        <stzh-cspace>\n            \n            <stzh-accordion>\n                    <div class=\"accordionitem section\">\n    <stzh-accordion-item heading=\"Weitere Fachplanende\">\n        <stzh-cspace><div class=\"has-textandimage section\">\n    \n        <stzh-section padding-bottom=\"default\" padding-top=\"default\">\n            <stzh-content>\n                <stzh-cspace>\n                    \n                    \n\n                    <stzh-textandimage size=\"small\">\n                        <div slot=\"left\">\n                            <stzh-richtext><ul>\n<li><strong>Landschaftsarchitektur </strong>manoa Landschaftsarchitekten GmbH, Meilen</li>\n<li><strong>Bauphysik + Energie </strong>EK Energiekonzepte AG, Zürich</li>\n<li><strong>HLK-Planung</strong> Raumanzug, Zürich</li>\n</ul>\n</stzh-richtext>\n                        </div>\n                        \n                    </stzh-textandimage>\n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n\n</div>\n\n</stzh-cspace>\n    </stzh-accordion-item>\n\n\n\n    \n\n</div>\n\n\n            </stzh-accordion>\n        </stzh-cspace>\n    </stzh-content>\n</stzh-section></div>\n<div class=\"contact section\">\n    \n        <stzh-section>\n            <stzh-content>\n                <stzh-cspace>\n                    \n\n                    \n\n                    <stzh-contact id=\"standort\" with-border=\"false\" type=\"Organization\" main-heading=\"Standort\" heading=\"Recyclingzentrum Juch-Areal\" street=\"[&#34;Juchstrasse 19&#34;]\" street-info=\"[]\" postal-code=\"8048\" location=\"Zürich\" numbers=\"[]\" websites=\"[]\">\n                        \n\n                        \n\n\n                        <stzh-accordion>\n                            \n\n                            \n\n                            <stzh-accordion-item id=\"bprm10825_map\" open heading=\"Karte\">\n                                <stzh-olmap center='[2678816.0, 1249917.0]'></stzh-olmap>\n                                \n                            </stzh-accordion-item>\n\n                            \n\n                            \n\n                            \n\n                            \n                            \n\n                            \n\n                            \n\n                            \n\n                            \n\n                            \n                        </stzh-accordion>\n                    </stzh-contact>\n\n                    \n                </stzh-cspace>\n            </stzh-content>\n        </stzh-section>\n    \n\n    \n    \n\n\n</div>\n\n</div>\n<div class=\"mainparsys parsys\">\n</div>\n<div class=\"