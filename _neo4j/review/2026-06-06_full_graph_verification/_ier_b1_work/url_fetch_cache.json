\\":8.18,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#bcbdbb\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#8c8c88\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.51,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#7f817d\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"originalFilename\\\":\\\"Thoravej_Enkeltbilleder_287_Væ_FotoHB_high.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/f6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg\\\",\\\"sha1hash\\\":\\\"f6fe61f635e80a0ca8d5396cb575b9e84bae8dd7\\\",\\\"size\\\":6925143,\\\"uploadId\\\":\\\"0vIJkDyAwVX7glZL0FzI3npeLQsOk4vh\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/f6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg\\\"}}},{\\\"_key\\\":\\\"c81115da59ee\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"e83077e5f116\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Custom-Designed Furniture from Svanninge Bjerge Wood\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"c8d767904b8f\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"b1ce917e0129\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The Bikuben Foundation manages the Svanninge Bjerge nature reserve in southern Funen to increase biodiversity. Some trees that were already scheduled to be felled to allow more light to reach the forest floor were transformed into furniture now featured at Thoravej 29.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"e80e7245da3f\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"8fa3101dddc8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Typically, furniture production involves ordering raw planks from a lumberyard. In this case, Pihlmann Architects, the Bikuben Foundation, and designer Sara Martinsen personally selected the trees in the forest.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"a688f5b82220\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Karina Tybjeg\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T10:19:59Z\\\",\\\"_id\\\":\\\"image-3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912-jpg\\\",\\\"_rev\\\":\\\"JLKvYdmWOE02vgBAPyIeKN\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T10:19:59Z\\\",\\\"assetId\\\":\\\"3458f31068be2d56e165e3a0d2994f570cd8e119\\\",\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"V6B:$^IV00_N%N00M{%MWCtR-=x]t8M{ofROt7t8WBRi\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":1.498371335504886,\\\"height\\\":4912,\\\"width\\\":7360},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#5c542c\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#62232d\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.03,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#bdc0c4\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":8.03,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#bdc0c4\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":8.03,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#d8a0a0\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#828384\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.16,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#ae4646\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.01,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"originalFilename\\\":\\\"Svanninge Bjerge50.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg\\\",\\\"sha1hash\\\":\\\"3458f31068be2d56e165e3a0d2994f570cd8e119\\\",\\\"size\\\":18667333,\\\"uploadId\\\":\\\"iCGp3BI7OvIGZyCTMjhYCBRb2oQYBIhN\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg\\\"}}},{\\\"_key\\\":\\\"6eb9b0ff1c9f\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"95a510ed5253\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Working with wood from a biodiversity-focused forest sometimes requires adjustments to the schedule – for example, tree felling had to be postponed to avoid disturbing the birds’ breeding season.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"3813893e2b9c\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"0c123d8bd81f\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The design and carpentry studio\\\"},{\\\"_key\\\":\\\"3f208fa88253\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"24b69e742c5f\\\"],\\\"text\\\":\\\" Archival Studies\\\"},{\\\"_key\\\":\\\"cf21392501c3\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" was chosen by Pihlmann Architects and Sara Martinsen to design and produce outdoor furniture for the rooftop terrace and high chairs for the ground-floor café. They also explored the potential of using “green” (unseasoned) wood directly from the forest. Working with wet wood reduces energy consumption because it avoids drying and post-processing, while also allowing a greater portion of the tree trunk to be utilized compared to conventional furniture production.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"24b69e742c5f\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://archivalstudies.net/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"804d7e62a478\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Emilia Boeng Nordland\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T11:13:06Z\\\",\\\"_id\\\":\\\"image-d5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284-png\\\",\\\"_rev\\\":\\\"7Gq1XukqEhCh9oF8jYFZzJ\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T11:13:06Z\\\",\\\"assetId\\\":\\\"d5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555\\\",\\\"description\\\":null,\\\"extension\\\":\\\"png\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"d9BD[Y-p_K?r%yW9t6s=NMRiM{oztQWTRQbbt7fhWEt8\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.7546728971962616,\\\"height\\\":1284,\\\"width\\\":969},\\\"hasAlpha\\\":true,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"$27\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#425527\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.42,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#5e7609\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.53,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c1d0a2\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":5.96,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c1d0a2\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":5.96,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#d9e891\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#000\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#8c9d51\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":5.55,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#859a20\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.06,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/png\\\",\\\"originalFilename\\\":\\\"Skærmbillede 2025-10-21 131249.png\\\",\\\"path\\\":\\\"images/o0gogd4q/production/d5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png\\\",\\\"sha1hash\\\":\\\"d5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555\\\",\\\"size\\\":3168651,\\\"uploadId\\\":\\\"TeuMyW2wx9ms9SQMgSFPc7bzg8TxCZ5M\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/d5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png\\\"}}},{\\\"_key\\\":\\\"72ce8b0b361b\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"874e79c5a40e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Selected Nordic wood species include pine, grandis, larch, Douglas fir, beech, and maple, along with some cypress. Oak was deliberately avoided by Archival Studies and Sara Martinsen to demonstrate that aesthetic and functional furniture can also be made from fast-growing, more affordable species.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"31b5eb88b765\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"45e551f6607a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The goal was also to create variety in wood types, since overreliance on a narrow selection in production forests leads to monocultures. This approach may inspire the use of alternative wood species beyond oak, which has long been the most sought-after timber.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"6748ab2ccd0b\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"2182fc1bf771\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Designers Behind the Furniture\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"d71a5c1c3cad\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"5173ad1beb0f\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"In addition to Archival Studies, the exhibition platform and creative community \\\"},{\\\"_key\\\":\\\"152b280eaa75\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"107758ac4b17\\\"],\\\"text\\\":\\\"Ukurant\\\"},{\\\"_key\\\":\\\"b565fcf3f6f0\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" selected talented young designers to create custom furniture for Thoravej 29:\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"107758ac4b17\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://ukurant.com/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"2d16468ec816\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"5b9778d1f6d1\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Design Duo: \\\"},{\\\"_key\\\":\\\"11014bfe2b20\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"2a1791b3293a\\\"],\\\"text\\\":\\\"Christian + Jade\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"2a1791b3293a\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.christianandjade.com/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"983d7cb9ca50\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"d0b86fdb6ffe\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"em\\\"],\\\"text\\\":\\\"12 Stools\\\"},{\\\"_key\\\":\\\"5a4f10e9d419\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"\\\\nIn the spirit of sustainability, three beams of grandis wood from Svanninge Bjerge (15 × 15 × 400 cm) were sliced to produce exactly twelve stools – no more, no less. The stools retain the natural weight and volume of the beams and draw inspiration from the visible construction and joinery of Thoravej 29. Each stool allows the “living” wood to move naturally, with cracks stabilized and highlighted by metal brackets that embrace and accentuate the material’s vitality.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"bbe2536a1331\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Samuel Causse\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T09:36:25Z\\\",\\\"_id\\\":\\\"image-56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647-jpg\\\",\\\"_rev\\\":\\\"0rMzyCcxaZvfkTfPcfdQzb\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T09:36:25Z\\\",\\\"assetId\\\":\\\"56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b\\\",\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"d9E{IQ4TpfxC]x-VwYES9E?F=sE2b{Ioxvnh_3NK9b-o\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.6667256950593236,\\\"height\\\":5647,\\\"width\\\":3765},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#644934\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":1.43,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#52210d\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":3.97,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#ac8e68\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.2,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#9fb0cc\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0.44,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#dcc3a3\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":4.76,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#ac8e68\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.2,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#987748\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":1.15,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"originalFilename\\\":\\\"10_Christian+Jade_foto Samuel Causse.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg\\\",\\\"sha1hash\\\":\\\"56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b\\\",\\\"size\\\":18406007,\\\"uploadId\\\":\\\"yb1mELft2vrOza6Muilf4Kd2ul6NSTD3\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg\\\"}}},{\\\"_key\\\":\\\"a1d9d1c4add6\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"b9024635c0d7\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Designer: \\\"},{\\\"_key\\\":\\\"5ad73b3c4858\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"5a21c50e4bdb\\\"],\\\"text\\\":\\\"Anne Skaarup Jaedicke\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"5a21c50e4bdb\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.instagram.com/annethegreatest/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"278bbaab7468\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"aa8b20c4d9af\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"em\\\"],\\\"text\\\":\\\"12 Stools\\\"},{\\\"_key\\\":\\\"602b494effc2\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"\\\\n‘Taburet 29’ is crafted from grandis wood from Svanninge Bjerge. Its simple, geometric form serves as a canvas for surface embossing – the number “29,” reflecting the building’s address, emerges through stamped impressions. The raw and chaotic stamping is inspired by timber numbering during felling, creating a tactile depth and inviting viewers to experience the wood’s natural details anew.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"82d9704742d3\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Samuel Causse\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T09:38:03Z\\\",\\\"_id\\\":\\\"image-aa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998-jpg\\\",\\\"_rev\\\":\\\"0rMzyCcxaZvfkTfPcfdWGH\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T09:38:03Z\\\",\\\"assetId\\\":\\\"aa9144319ecb7224c4f7ffab239a9aec74a1dc3b\\\",\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"dCELjJ.AE2n4=Z,mIUV@4.M{tRx]=vM|bwxZNg?G%MR*\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.6666666666666666,\\\"height\\\":4998,\\\"width\\\":3332},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#4b342f\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":1.1,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#673207\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":2.17,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c5afa4\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":2.35,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c5afa4\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":2.35,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#e7bd90\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0.07,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#a5875e\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.7,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c36f37\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.67,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"originalFilename\\\":\\\"18_Anne Skaarup Jaedicke_foto Samuel Causse.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/aa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg\\\",\\\"sha1hash\\\":\\\"aa9144319ecb7224c4f7ffab239a9aec74a1dc3b\\\",\\\"size\\\":11772995,\\\"uploadId\\\":\\\"Mm7ZIc2fTueaFtYNRRrNxIUMgyzgfPje\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/aa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg\\\"}}},{\\\"_key\\\":\\\"d3ca3736e9af\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"daeed969f6fe\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Designer: \\\"},{\\\"_key\\\":\\\"bf50c9d99a50\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"5c0cb4c405ab\\\"],\\\"text\\\":\\\"Anna Søgaard\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"5c0cb4c405ab\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://www.annasoegaard.dk/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"87c5943e6758\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"04c93f07b902\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"em\\\"],\\\"text\\\":\\\"Table Supports\\\"},{\\\"_key\\\":\\\"32fa49e2acb8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"\\\\nInspired by traditional carpenter trestles, Anna Søgaard designed flexible, stackable table supports made from maple and beech from Svanninge Bjerge. The top of the trestle is shaped as an I-profile for strength and stability. The three-leg design saves material and weight while providing extra seating space. All elements are dimensionally uniform, assembled with countersunk screws, and feature a small saddle connecting leg to beam. When not in use, the trestles can be stacked to form a sculptural installation, combining functionality, sustainability, and a connection to nature.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"12c5c45b674f\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Samuel Causse\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T09:38:40Z\\\",\\\"_id\\\":\\\"image-c185193a604c450284632ae92d91d8fb9f787fbc-3737x5605-jpg\\\",\\\"_rev\\\":\\\"7Gq1XukqEhCh9oF8jXx6pf\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T09:38:40Z\\\",\\\"assetId\\\":\\\"c185193a604c450284632ae92d91d8fb9f787fbc\\\",\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"dJJ@XdZgsm%2~pMwV@R-00MyM{ofRjW=kW%2~pt8xuae\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.6667261373773417,\\\"height\\\":5605,\\\"width\\\":3737},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#534435\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.12,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#552d0f\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":4.95,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#552d0f\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":4.95,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c6b4a7\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":2.07,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#e9cca9\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":3.21,\\\"title\\\":\\\"#000\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#a78461\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":1.43,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#a6774f\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":4.38,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"originalFilename\\\":\\\"06_Anna Søgaard_foto Samuel Causse.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/c185193a604c450284632ae92d91d8fb9f787fbc-3737x5605.jpg\\\",\\\"sha1hash\\\":\\\"c185193a604c450284632ae92d91d8fb9f787fbc\\\",\\\"size\\\":11518579,\\\"uploadId\\\":\\\"MYG7XvphNUhtZ8A06bgOB9j0eTvMqe8b\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/c185193a604c450284632ae92d91d8fb9f787fbc-3737x5605.jpg\\\"}}}],\\\"headline\\\":\\\"Inventory\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T11:07:02Z\\\",\\\"_id\\\":\\\"image-a83d95240aa892358407930366e7b827d0723eae-3840x5120-jpg\\\",\\\"_rev\\\":\\\"JLKvYdmWOE02vgBAPyQ7XL\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T11:10:44Z\\\",\\\"altText\\\":null,\\\"assetId\\\":\\\"a83d95240aa892358407930366e7b827d0723eae\\\",\\\"creditLine\\\":null,\\\"description\\\":\\\"Copyright: Thom Geraeds\\\",\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"dRG*~8Mw-;x]~padt7xv?boxjGxuWFRja{j]sTWBfjbH\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.75,\\\"height\\\":5120,\\\"width\\\":3840},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#583f33\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":6.19,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#542320\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.81,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#542320\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.81,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c7c4b0\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0.7,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#d5caa4\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#000\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#a17259\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":1.56,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c3b47c\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0.07,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"opt\\\":{\\\"media\\\":{\\\"tags\\\":null}},\\\"originalFilename\\\":\\\"Thom_Geraeds_June254A1744-4.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/a83d95240aa892358407930366e7b827d0723eae-3840x5120.jpg\\\",\\\"sha1hash\\\":\\\"a83d95240aa892358407930366e7b827d0723eae\\\",\\\"size\\\":4794424,\\\"title\\\":null,\\\"uploadId\\\":\\\"XrAthWYsiaP5lbrSH5qWsYd62yaoWxcr\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/a83d95240aa892358407930366e7b827d0723eae-3840x5120.jpg\\\"}}},{\\\"_key\\\":\\\"323bf2039c2a\\\",\\\"_type\\\":\\\"section\\\",\\\"content\\\":[{\\\"_key\\\":\\\"9aa99e661130\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"932027e4eafc\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Used Furniture\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"0172ee2bdb6f\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"fd2240bf1eb2\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The average lifespan of a piece of furniture is 10–15 years. By purchasing furniture from the 1970s and 1980s, we significantly extend the life of these pieces. Tusindfryds Loppeland sourced used furniture over a period of approximately eight months, following a specific list provided by interior design consultant Sara Martinsen.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"dcd805f9851b\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"dbd6f69e683c\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"In addition to collecting items, they also handled reupholstering where needed. Purchasing used furniture while achieving a cohesive aesthetic is a complex task. The Bikuben Foundation specifically aimed to buy used upholstered furniture, as these pieces have a high carbon footprint due to the amount of foam involved.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"52bee0e76ca9\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"aa051fcc6cbb\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Upholstered furniture can be very worn, so close dialogue with the purchaser and ongoing quality checks are crucial, and reupholstering may be necessary.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"776aad7ad96a\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"848f85fc8f4e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Furthermore, all office chairs in the building were purchased as used items. To maintain a cohesive look, it is important to source 30–50 of the same chair model, with matching frame and seat colors. This requires careful specification and a targeted sourcing process, often acquiring sets of four to six at a time until a uniform collection is assembled.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"9fef7f27ef81\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"ee7e64db7e9c\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The category “Used Furniture” also includes items brought from Enigheden, where the Bikuben Foundation and \\\"},{\\\"_key\\\":\\\"0f1dca8e487b\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"bf8a31f7fcf8\\\"],\\\"text\\\":\\\"the community\\\"},{\\\"_key\\\":\\\"2535a08d6735\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" were temporarily based during the renovation. For example, many table frames were relocated and fitted with new tabletops if worn. Furniture that was not moved was sold through an internal “moving sale.” Approximately 70–75% of the total furniture for Thoravej 29 consists of used items.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"bf8a31f7fcf8\\\",\\\"_type\\\":\\\"link\\\",\\\"internalLink\\\":{\\\"language\\\":\\\"en\\\",\\\"slug\\\":{\\\"_type\\\":\\\"slug\\\",\\\"current\\\":\\\"community-members\\\"},\\\"type\\\":\\\"page\\\"}}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"d9fba64b8500\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Thom Geraeds\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T11:06:40Z\\\",\\\"_id\\\":\\\"image-140f0af9f4a22a381e383f2c4e5d24b1071d6a74-3814x4720-jpg\\\",\\\"_rev\\\":\\\"7Gq1XukqEhCh9oF8jYGIQX\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T11:15:20Z\\\",\\\"altText\\\":null,\\\"assetId\\\":\\\"140f0af9f4a22a381e383f2c4e5d24b1071d6a74\\\",\\\"creditLine\\\":null,\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"ePE2tR%Nog%Loz~VWYNGoebI-:ozkCoMoft7t7ofofofV@RkRjafj[\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.8080508474576271,\\\"height\\\":4720,\\\"width\\\":3814},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#503f2e\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":6.1,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#3c2404\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.07,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#503f2e\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":6.1,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#c5ab8e\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":1.5,\\\"title\\\":\\\"#fff\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#f6c482\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#000\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#a4865c\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.01,\\\"title\\\":\\\"#fff\\\"},\\\"vibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#ef8f0f\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"}}},\\\"mimeType\\\":\\\"image/jpeg\\\",\\\"opt\\\":{\\\"media\\\":{\\\"tags\\\":null}},\\\"originalFilename\\\":\\\"Thom_Geraeds_June254A1762-1.jpg\\\",\\\"path\\\":\\\"images/o0gogd4q/production/140f0af9f4a22a381e383f2c4e5d24b1071d6a74-3814x4720.jpg\\\",\\\"sha1hash\\\":\\\"140f0af9f4a22a381e383f2c4e5d24b1071d6a74\\\",\\\"size\\\":9133989,\\\"title\\\":null,\\\"uploadId\\\":\\\"iIWAlvthIxt7ZxWsW6ElBduc5KA4ktgz\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/o0gogd4q/production/140f0af9f4a22a381e383f2c4e5d24b1071d6a74-3814x4720.jpg\\\"}}},{\\\"_key\\\":\\\"11f8e17d5e75\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"b70269561b09\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"New Furniture\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"h3\\\"},{\\\"_key\\\":\\\"be1dba3b2c35\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"129ef1064c78\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"A small portion of the furniture was newly purchased, primarily pieces with specific functional requirements, such as frames for height-adjustable tables. The tabletops were produced from recycled wood waste sourced from Danish furniture manufacturers.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"d5cfd5e80d11\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"e5fa000d3b2e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The building’s telephone booths are also new acquisitions. It was difficult to find manufacturers that met the required environmental standards, so Sara Martinsen reached out to \\\"},{\\\"_key\\\":\\\"35ad7f7c4296\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"73c3c2491326\\\"],\\\"text\\\":\\\"PhoneAlone\\\"},{\\\"_key\\\":\\\"d074f8ae14ec\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\", who saw the benefit of a development partnership to create a more responsible telephone booth that matched Thoravej 29 in both sustainability and aesthetics.\\\"}],\\\"markDefs\\\":[{\\\"_key\\\":\\\"73c3c2491326\\\",\\\"_type\\\":\\\"link\\\",\\\"externalUrl\\\":\\\"https://phonealone.dk/\\\",\\\"internalLink\\\":null}],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"7ce6faf40b7f\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"fa7f0c67629e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"The exterior layers of the booths were stripped down, leaving raw chipboard with a transparent lacquer. Cork was used as a substitute for foam in the inner core. The absorbing surface inside the booths is made from PET felt, 80% of which comes from recycled plastic bottles. The booths are designed with a click system, allowing them to be dismantled, reassembled, or repaired without damaging the chipboard – a common problem with screw assemblies.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"59817a9b57bb\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"dadc2f020795\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"When purchasing new furniture, the focus was on durability, maintenance, and responsible material choices. Many items are designed so that individual components can be replaced without discarding the entire piece due to a small defect or damage. Furniture was also sourced locally whenever possible, and items produced outside Europe were generally avoided.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"3cac68c5ed37\\\",\\\"_type\\\":\\\"richtextimage\\\",\\\"caption\\\":\\\"Copyright: Hampus Berndtson\\\",\\\"image\\\":{\\\"_type\\\":\\\"image\\\",\\\"asset\\\":{\\\"_createdAt\\\":\\\"2025-10-21T10:30:11Z\\\",\\\"_id\\\":\\\"image-001213675d559619af10dd5834918e27a8586ee3-1920x2560-jpg\\\",\\\"_rev\\\":\\\"0rMzyCcxaZvfkTfPcftZOU\\\",\\\"_type\\\":\\\"sanity.imageAsset\\\",\\\"_updatedAt\\\":\\\"2025-10-21T10:30:11Z\\\",\\\"assetId\\\":\\\"001213675d559619af10dd5834918e27a8586ee3\\\",\\\"description\\\":null,\\\"extension\\\":\\\"jpg\\\",\\\"metadata\\\":{\\\"_type\\\":\\\"sanity.imageMetadata\\\",\\\"blurHash\\\":\\\"d4D,Dxi]01of57xuV?kC00Di^*%M~A%g9bWC~BRiIVRk\\\",\\\"dimensions\\\":{\\\"_type\\\":\\\"sanity.imageDimensions\\\",\\\"aspectRatio\\\":0.75,\\\"height\\\":2560,\\\"width\\\":1920},\\\"hasAlpha\\\":false,\\\"isOpaque\\\":true,\\\"lqip\\\":\\\"data:image/jpeg;base64,\\\",\\\"palette\\\":{\\\"_type\\\":\\\"sanity.imagePalette\\\",\\\"darkMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#3c4043\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.85,\\\"title\\\":\\\"#fff\\\"},\\\"darkVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#041417\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":0.02,\\\"title\\\":\\\"#fff\\\"},\\\"dominant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#3c4043\\\",\\\"foreground\\\":\\\"#fff\\\",\\\"population\\\":7.85,\\\"title\\\":\\\"#fff\\\"},\\\"lightMuted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#d6cdc2\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":6.71,\\\"title\\\":\\\"#000\\\"},\\\"lightVibrant\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#8edceb\\\",\\\"foreground\\\":\\\"#000\\\",\\\"population\\\":0,\\\"title\\\":\\\"#fff\\\"},\\\"muted\\\":{\\\"_type\\\":\\\"sanity.imagePaletteSwatch\\\",\\\"background\\\":\\\"#71787c\\\",\\\"foreground\\\":\\\"#fff\\\",\\