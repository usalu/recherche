r\n            \r\n        </div>\r\n    </div>\r\n\r\n\r\n\r\n    <img class=\"image-item slide-image-hidden\" src=\"/media/kksoxkyp/94ad2c2c3feec32c488addf7049b8a11.jpg?format=webp&amp;autoorient=true\" alt=\"\" title=\"\" />\r\n            <div class=\"d-none slide-caption-hidden\">\r\n                Credit: Sebastian Ziegler\r\n            </div>\r\n</div>        </div>\r\n        <div class=\"gallery-block__swiper-buttons\">\r\n            <button class=\"gallery-block__swiper-button--prev\" aria-label=\"Previous slide\">\r\n                \r\n<svg width=\"42\" height=\"42\" viewBox=\"0 0 42 42\" xmlns=\"http://www.w3.org/2000/svg\" class=\"\">\r\n    <path id=\"arrow\" d=\"M1.05581 34.8014L24.822 11.0352L0.874388 11.0352L0.874389 0.875611H41.8756V41.8768L31.716 41.8768L31.716 17.9292L7.94982 41.6954L1.05581 34.8014Z\" />\r\n</svg>\r\n            </button>\r\n            <button class=\"gallery-block__swiper-button--next\" aria-label=\"Next slide\">\r\n                \r\n<svg width=\"42\" height=\"42\" viewBox=\"0 0 42 42\" xmlns=\"http://www.w3.org/2000/svg\" class=\"\">\r\n    <path id=\"arrow\" d=\"M1.05581 34.8014L24.822 11.0352L0.874388 11.0352L0.874389 0.875611H41.8756V41.8768L31.716 41.8768L31.716 17.9292L7.94982 41.6954L1.05581 34.8014Z\" />\r\n</svg>\r\n            </button>\r\n        </div>\r\n    </div>\r\n    <div class=\"gallery-block__modal modal\" aria-hidden=\"true\" x-ref=\"modalEl\">\r\n    <div class=\"gallery-block__modal-dialog modal-dialog\">\r\n        <div class=\"gallery-block__modal-content modal-content block-background--black\">\r\n            <div class=\"gallery-block__modal-body modal-body\">\r\n                <div class=\"gallery-block__modal-float\">\r\n                    <div class=\"gallery-block__modal-main-content\">\r\n                        <div class=\"gallery-block__modal-buttons\">\r\n                            <div class=\"gallery-block__modal-buttons--top\">\r\n                                \r\n\r\n    <butt