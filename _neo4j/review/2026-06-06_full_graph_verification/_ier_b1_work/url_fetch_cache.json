om/imagesloaded@4/imagesloaded.pkgd.min.js\"></script>\n    \n    <style>\n    @media screen and (max-width: 1200px) {\n        .page-id-3 .custom-row,\n        .page-id-4 .custom-row {\n            display: flex;\n            flex-direction: column;\n        }\n        \n        .page-id-3 .custom-row .content-left,\n        .page-id-4 .custom-row .content-left {\n            order: 3;\n        }\n    }\n    \n    /* Adding arrow to the homepage and adapting the CSS slightly */\n    .template-Homepage main {\n        padding-top: 0;\n        top: 90vh;\n    }\n    \n    .arrow-down-icon {\n        width: 5vh;\n        height: 5vh;\n        margin: 45px auto 45px;\n        display: block;\n    }\n    \n    /* Press publications design changes */ \n    p.press-publication {\n        display: block;\n        margin-bottom: 0.25em;\n    }\n    \n    .template-Presse h2 {\n        text-transform: uppercase;\n        margin-bottom: 1.5em;\n        font-size: 1.25em;\n    }\n    \n    body.template-Presse .container .custom-row .content-left {\n        flex-direction: column;\n    }\n    \n    /* Pulse animation vor down-arrow on startpage */\n    .template-Homepage .arrow-down-icon {\n        -webkit-animation: mover 1s infinite  alternate;\n        animation: mover 1s infinite  alternate;\n    }\n    .template-Homepage .arrow-down-icon {\n        -webkit-animation: mover 1s infinite  alternate;\n        animation: mover 1s infinite  alternate;\n    }\n    @-webkit-keyframes mover {\n        0% { transform: translateY(0); }\n        100% { transform: translateY(-10px); }\n    }\n    @keyframes mover {\n        0% { transform: translateY(0); }\n        100% { transform: translateY(-10px); }\n    }\n    \n    </style>\n    \n <style>\n/*=================================\n=            Variables            =\n=================================*/\n\n:root {\n  --color-blue: #0203e2;\n  --color-light-gray: #f5f5f5;\n  --color-nude: #f6c7b3;\n  --color-light-green: #bbdbca;\n  --color-light-blue: #cedbed;\n}\n\n\n/*=================================\n=            Heading Styles       =\n=================================*/\n\nh2.heading, h1.heading {\n  font-size: 1.5rem;\n  line-height: 1.5em;\n  margin: 4rem 0;\n}\n\nul > li {\n  font-weight: 400;\n}\n\n.heading.alignment-centered {\n  margin-left: auto;\n  margin-right: auto;\n}\n\n@media (min-width: 768px) {\n  h2.heading, h1.heading {\n    font-size: 2rem;\n  }\n  \n  .heading {\n    max-width: 40ch;\n  }\n  \n  .heading.alignment-left {\n    text-align: left;\n  }\n  \n  .heading.alignment-center,\n  .alignment-centered {\n    text-align: center;\n  }\n  \n  p {\n    max-width: 65ch;\n  }\n}\n\n/*=================================\n=         Utility Classes         =\n=================================*/\n\n.font-large, .font-large p {\n  font-size: 1.25rem;\n  letter-spacing: 0.25px;\n  line-height: 1.25em;\n  margin-bottom: 1.5rem;\n  font-family: \"Larsseit\", sans-serif;\n  font-weight: bold;\n}\n\n.font-large:last-of-type, .font-large p:last-of-type {\n  margin-bottom: 0;\n}\n\n@media (min-width: 768px) {\n  .font-large, .font-large p {\n    font-size: 1.55rem;\n  }\n}\n\n.font-uppercase {\n  text-transform: uppercase;\n}\n\n.mt-4 {\n  margin-top: 1em;\n}\n\n.mb-4 {\n  margin-bottom: 1em;\n}\n\n/*=================================\n=          Button Styles          =\n=================================*/\n\n.button {\n  color: var(--color-blue);\n  border: 1px solid var(--color-blue);\n  border-radius: 2em;\n  padding: 0.5em 1em;\n  transition: background-color 0.25s cubic-bezier(0.46, 0.46, 0, 0.95), color 0.25s ease-in-out;\n}\n\n.button:hover {\n  color: #fff;\n  background-color: var(--color-blue);\n}\n\n/*=================================\n=         Content Container       =\n=================================*/\n\n.container-content {\n  max-width: 100%;\n  margin: 0 auto;\n}\n\n@media (min-width: 1200px) {\n  .container-content {\n    max-width: 1200px;\n  }\n}\n\n/*=================================\n=       Two-Column Layout         =\n=================================*/\n\n.row.two-column {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.row.two-column > .column {\n  flex: 1 1 100%;\n  box-sizing: border-box;\n}\n\n@media (min-width: 1200px) {\n  .row.two-column {\n    flex-direction: row;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .row.two-column > .column {\n    flex: 1 1 50%;\n  }\n}\n\n/*=================================\n=         Image Optimization      =\n=================================*/\n\n.row.two-column img {\n  max-height: 40rem;\n  width: auto;\n  object-fit: contain;\n  margin: 0 auto;\n}\n\n/*=================================\n=        Offset Layout Styles     =\n=================================*/\n\nsection.row.offset-left {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  gap: 1rem;\n}\n\n.offset-left {\n  flex: 1;\n}\n\n.row-main-content {\n  flex: 1;\n}\n\n@media (min-width: 768px) {\n  section.row.offset-left {\n    flex-direction: row;\n  }\n\n  .offset-left {\n    flex: 0 0 25%;\n  }\n\n  .row-main-content {\n    flex: 0 0 75%;\n  }\n  \n  .offset-left h2 {\n    position: sticky;\n    top: 8rem;\n  }\n}\n\n/*=================================\n=        Accordion Styles         =\n=================================*/\n\n.accordion-header, .accordion-icon {\n  cursor: pointer;\n}\n\n.accordion-header h2 {\n  margin-bottom: 0;\n}\n\n.accordion-item {\n  position: relative;\n  width: 100%;\n  padding: 1.25rem 0;\n  display: flex;\n  flex-direction: column;\n  border-top: 1px solid #0203e2;\n}\n\n.accordion-item:focus {\n  outline: none;\n}\n\n.accordion-item:last-child {\n  border-bottom: 1px solid #0203e2;\n}\n\n.accordion-icon {\n  position: absolute;\n  right: 0;\n  top: 1rem;\n  width: 2.5rem;\n  height: 2.5rem;\n}\n\n.accordion-icon .vertical-line {\n  transition: transform 0.3s cubic-bezier(0.65, 0.05, 0.36, 1);\n  transform-origin: center;\n}\n\n.accordion-header.active .vertical-line {\n  transform: rotate(90deg);\n}\n\n.accordion-content {\n  max-height: 0;\n  opacity: 0;\n  overflow: hidden;\n  transition: max-height 0.3s cubic-bezier(0.65, 0.05, 0.36, 1), opacity 0.3s cubic-bezier(0.65, 0.05, 0.36, 1);\n}\n\n.accordion-content.active {\n  max-height: 500px;\n  opacity: 1;\n}\n\n@media (min-width: 768px) {\n  .accordion-item {\n    flex-direction: row;\n  }\n\n  .accordion-header {\n    flex: 0 0 25%;\n  }\n\n  .accordion-content {\n    flex: 0 0 75%;\n  }\n  \n  .accordion-headline h2 {\n    position: sticky;\n    top: 8rem;\n  }\n}\n\n/*=================================\n=           Card Grid             =\n=================================*/\n\n.card-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 2rem;\n}\n\n@media (min-width: 768px) {\n  .card-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (min-width: 1024px) {\n  .card-grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n.team-grid {\n  align-items: end;\n  margin-bottom: 4rem;\n}\n\n.team-member-position {\n  font-weight: 400;\n}\n\n/*=================================\n=       Mobile Row Fixes          =\n=================================*/\n\n@media screen and (max-width: 768px) {\n  .row [class^=\"col\"], .row [class^=\"col\"]:last-of-type {\n    margin: 0.5rem 0;\n    float: left;\n  }\n}\n\n\n/*=================================\n=       Desktop Row Changes          =\n=================================*/\n\n/* Increase padding on homepage for rows on desktop */\n\n@media screen and (min-width: 1024px) {\n    .template-Homepage.V2 .row {\n        margin-bottom: 5rem;\n    }\n}\n\n/*=================================\n=       Footer Changes            =\n=================================*/\n\nfooter {\n    font-weight: bold;\n}\n\n/*=================================\n=       Small Fixes               =\n=================================*/\n\n/* Remove space below icon to align spaces better */\n.arrow-down-icon {\n    margin-bottom: -1.25rem;\n}\n\n/* Fix slightly off overhang on project-grid */\n@media screen and (min-width: 768px) {\n    .project-grid.v2 {\n        margin-left: -14px;\n        margin-right: -14px;\n    }\n}\n\n/* Remove the margin from the project-grid element when a heading is above */\n.heading + .news-grid .project-grid {\n    margin-top: 0;\n}\n\n/* If the row has a news-grid / project-grid the headline should be sized according to specifications */\n.row:has(.heading + .news-grid) .heading {\n    margin-bottom: 0;\n    font-size: 21px;\n}\n\n.column:has(> img:only-child) {\n    display: flex;\n}\n\n@media screen and (max-width: 1200px) {\n    .row [class^=\"col\"] {\n        margin: 0;\n    }\n}\n\n*:not(.button) + .button {\n  margin-top: 2.25rem;\n  display: inline-block;\n}\n\n@media screen and (max-width: 768px) {\n  .button {\n    display: block !important;\n    text-align: center;\n  }\n}\n\n/* When a heading is directly followed by a .font-large then reduce the margin to make the rhythm work again */\n.heading:has(+ .font-large) {\n  margin-bottom: 1.5rem;\n}\n\n/*=================================\n=       Gallery Slider            =\n=================================*/\n\n.gallery-slider {\n  width: 100%;\n  margin: auto;\n}\n\n.gallery-slider:not(.flickity-enabled) {\n  opacity: 0;\n  transition: opacity 0.5s;\n}\n\n.gallery-slider.flickity-enabled {\n  opacity: 1;\n  transition: opacity 1s;\n}\n\n.gallery-slider .flickity-button {\n  width: 50%;\n  height: 100%;\n  background: transparent !important;\n  opacity: 0 !important;\n  padding: 0;\n}\n\n.gallery-slider .flickity-button .flickity-button-icon {\n  display: none;\n}\n\n.gallery-slider .flickity-button.flickity-prev-next-button.next {\n  cursor: url('/assets/graphics/arrow-right.png') 25 25, pointer;\n}\n\n.gallery-slider .flickity-button.flickity-prev-next-button.previous {\n  cursor: url('/assets/graphics/arrow-left.png') 25 25, pointer;\n}\n\n/* Fix footer padding and width */\n@media screen and (min-width: 768px) and (max-width: 1024px) {\n\n    footer .container {\n        width: 100%;\n        padding: 1.25rem;\n        box-sizing: border-box;\n    }\n    \n    footer .container .row {\n        display: flex;\n        flex-direction: row;\n        justify-content: space-between;\n    }\n\n}\n\n@media only screen and (min-width: 60em) and (max-width: 1200px) {\n    .container {\n        width: 100%;\n        max-width: 100%;\n        padding: 0 3rem;\n        box-sizing: border-box;\n    }  \n}\n\n/*==============================================================\n=      Fixes and changes to the project detail page template   =\n================================================================*/\n\n\n@media screen and (min-width: 1200px) {\n    .container .custom-row .content-center {\n        width: 55%;\n        padding-left: 25%;\n        padding-top: 0;\n        margin-top: -20px;\n    }\n\n    .container .custom-row .content-right {\n        width: 20%;\n        padding-left: 0%;\n        padding-top: 0;\n        margin-top: -20px;\n    }\n    \n    .project-title {\n        width: 20%;\n        clear: both;\n    }\n}\n\n.content-center .row {\n    margin-top: 0;\n}\n\n.project-content .content-center, .project-content .content-right {\n    padding-top: 2rem;\n}\n\n\n</style>\n \n <script>\n    document.addEventListener('DOMContentLoaded', function() {\n      var items = document.querySelectorAll('.accordion-item');\n    \n      items.forEach(function(item) {\n        var header = item.querySelector('.accordion-header');\n        var content = item.querySelector('.accordion-content');\n    \n        function toggleAccordion() {\n          var isActive = header.classList.contains('active');\n    \n          // Toggle active class on header\n          header.classList.toggle('active');\n          // Update aria-expanded attribute\n          header.setAttribute('aria-expanded', !isActive);\n    \n          if (isActive) {\n            // Collapse content\n            content.style.maxHeight = content.scrollHeight + 'px';\n            content.classList.remove('active');\n            setTimeout(function() {\n              content.style.maxHeight = '0';\n            }, 10);\n          } else {\n            // Expand content\n            content.classList.add('active');\n            content.style.maxHeight = content.scrollHeight + 'px';\n          }\n        }\n    \n        // Click event listener on header\n        header.addEventListener('click', function(e) {\n          e.preventDefault();\n          toggleAccordion();\n        });\n    \n        // Keydown event listener for keyboard interaction\n        header.addEventListener('keydown', function(e) {\n          var key = e.key || e.code;\n    \n          if (key === 'Enter' || key === ' ' || key === 'Space') {\n            e.preventDefault();\n            toggleAccordion();\n          }\n        });\n      });\n    });\n\n</script>\n \n</head>\n\n<body class=\"template-Projekt page-id-313\" >\n\n<navbar class=\"navbar menu\">\n    <div class=\"brand\">\n        <a href=\"/en/\">\n            <img src=\"/assets/graphics/lxsy-architektur-logo.svg\" alt=\"LXSY Arcitektur - Logo\">\n        </a>\n    </div>\n    <div id=\"menuButton\">\n        <a id=\"menuButtonLink\" href=\"javascript:openNav();\">\n            <div class=\"hamburger\"></div>\n        </a>\n    </div>\n    \n    <div id=\"sideNavigation\" class=\"sidenav\">\n            <div class=\"main-menu\">\n                <a href=\"/en/projects\">Projects</a>\n                <a href=\"how-and-why\">HOW + WHY</a>\n                <a href=\"about\">About</a>\n                <a href=\"/en/news\">News</a>\n                <a href=\"/en/press\">Press</a>\n                <a href=\"contact\">Contact</a>\n            </div>\n            \n            \n            <div class=\"language-menu\">\n                <ul><a href=\"https://lxsy.de/projekte/impact-hub-berlin-at-crclr-house\" style=\"text-transform: uppercase;\" class=\"de nav-link\"><strong>de</strong></a></ul>\n            </div>\n           \n            \n            <div class=\"social-menu\">\n                <a href=\"https://www.facebook.com/LXSY.Architektur/\" target=\"_blank\">Facebook</a>\n                <a href=\"https://www.instagram.com/lxsy.architektur/\" target=\"_blank\">Instagram</a>\n                <a href=\"https://www.linkedin.com/company/lxsy-architektur\" target=\"_blank\">LinkedIn</a>\n            </div>\n            \n            <div class=\"legal-menu\">\n                <a href=\"/en/legal-information\">Imprint</a>\n                <a href=\"/en/privacy-policy\">Data Protection</a>\n             <!--   <a href=\"legal-information\">Imprint</a>\n                <a href=\"privacy-policy\">Data Protection</a>-->\n            </div>\n    </div>\n</navbar>\n\n\n<main>\n    <div class=\"project-slider-container\">\n        <div class=\"project-slider\">\n    <div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-01ihb_polis_dam_frame.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-02ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-03ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-04ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-05ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-06ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-07ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-08ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-09ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-10ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-11ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-12ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-13ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-14ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-15ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-16ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-17ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-18ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-19ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-20ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-21ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-22ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-23ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-24ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-25ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n<div class=\"project-slide\">\n    <img src=\"/assets/components/phpthumbof/cache/lxsy-architekten_arbeiten_crclr-house-berlin-26ihb.40ecfb746ce85d432ae4d2d3db256b5b313.jpg\" alt=\"\">\n</div>\n</div>\n    </div>\n    \n    <div class=\"project-content\">\n        <div class=\"project-content-inner container\">\n            <div class=\"project-title\">\n                <h4 class=\"category\">Realisation</h4>\n                <h1 class=\"title\">IMPACT HUB BERLIN at CRCLR-HOUSE</h1>\n            </div>\n            <div class=\"custom-row\">\n                <div class=\"content-center\"><div class=\" row\">\n    <p class=\"Body\"><span lang=\"EN-US\">On the site of the former Kindl brewery in Berlin's Neuk</span><span lang=\"SV\">&ouml;</span><span lang=\"EN-US\">lln district, the collaborative community and&nbsp;</span><span lang=\"IT\">co</span><span lang=\"EN-US\">-working space Impact Hub Berlin is opening for a new generation of entrepreneurs who focus on circular economy, sustainable food, diversity &amp; inclusion and green tech. For the development of the Kindl-Areal, aspects such as social compatibility, accessibility, diversity, environmental friendliness, resource conservation and waste avoidance play an essential role. Resource-saving construction also informs the interior design of Impact Hub Berlin at CRCLR-House by LXSY Architektur.</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">Back in 2015, LXSY Architektur approached the interior design of Impact Hub Berlin in Kreuzberg in a participatory and sustainable way. Two years later their concept earned them the German Design Award. In an exploration of circular construction methods, the new location takes into account aspects such as reusing of building components, flexibility, recycling</span><span lang=\"PT\">&nbsp;material,&nbsp;</span><span lang=\"EN-US\">facilitating future usage&nbsp;</span><span lang=\"FR\">changes</span><span lang=\"FR\">&nbsp;</span><span lang=\"EN-US\">and creating versatile structures. The necessary retrofitting of the former warehouse and its extension were carried out by TRNSFRM eG according to the design of Die Zusammenarbeiter. Recyclable materials, deconstructable and unmixed constructions and simple standards are used for the interior fittings. With the help of product and material passports, the elements used can be repurposed after disassembly. The process itself was accompanied by various workshops to explore sustainable construction methods and experimental approaches in prototyping.</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">The former warehouse is split into two levels by the installation of a wooden gallery. Adapted to the high level of the windows, emergency exits and the predetermined grid of the columns, accessible multifunctional rooms and team spaces are placed above and below the gallery level. Public areas on the ground floor, such as the caf</span><span lang=\"FR\">&eacute;</span><span lang=\"EN-US\">, are also made accessible to local residents. Other spaces are reserved for Impact Hub Berlin members. In a nod to the history of the site, the industrial character of the existing building can still be felt. Without the hall losing any of its spaciousness, the central rooms allow for indirect zoning. Adapted to the different needs, there are different room styles suited to either noisy or quiet working environments. The open spaces encourage dialogue with others, but also feature spaces to retreat to for concentrated work. The result is a varied mix of team areas, open co-working, meeting rooms, lounge and a caf</span><span lang=\"FR\">&eacute;&nbsp;</span><span lang=\"EN-US\">with a terrace. Telephone boxes, meeting booths and seating niches are distributed throughout the</span><span lang=\"DA\">&nbsp;levels</span><span lang=\"EN-US\">, while studios, workshop rooms and labs can be found in the basement.&nbsp;</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">The values of Impact Hub Berlin are incorporated into its design and are&nbsp;</span><span lang=\"FR\">visible&nbsp;</span><span lang=\"EN-US\">thanks to its transparency, openness and flexibility. The interplay of transparent, translucent and opaque walls characterises the design of interior spaces. Despite strong specifications such as the grid of the columns or the escape routes, the building&rsquo;s use is as flexible as&nbsp;</span><span lang=\"FR\">possible&nbsp;</span><span lang=\"EN-US\">in terms of the versatility of the size of the rooms. Based on the colour concept of Impact Hub Berlin's corporate design, the zoning is emphasised by specific</span><span lang=\"FR\">&nbsp;colours&nbsp;</span><span lang=\"EN-US\">which facilitate recognition and orientation. All rooms offer a friendly, bright atmosphere that put visitors at ease.&nbsp;</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">The material concept of Impact Hub Berlin at CRCLR-House involves both &ldquo;using materials as they are found\" and \"upcycling\". Around 70 percent of the materials and products used are recycled or sustainable. High-quality reused and new sustainable materials are used as they are. Damaged or uneven materials are treated to fit the design concept. The aesthetics of a circular building should deliberately dispel any prejudices around second-hand design or the notion of inferior materials. Despite the simplicity and the use of diverse materials, the design hinges on clarity</span><span lang=\"NL\">, homogene</span><span lang=\"EN-US\">ity and a high-quality aesthetic.&nbsp;</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">Materials and products used in the design&nbsp;</span><span lang=\"IT\">originate</span><span lang=\"EN-US\">d from demolition sites, trade fairs, museums and company stockpiles. The sliding doors of the telephone boxes, for example, were taken from former Impact Hub Berlin. The black MDF comes from a Berlin&nbsp;</span><span lang=\"NL\">club.&nbsp;</span><span lang=\"EN-US\">Local carpentry workshops were regularly canvassed to recycle wood offcuts and leftover pieces. The wooden standing grid with its width of 62.5 cm makes it possible to use even small offcuts of wood. Much of the furniture from old Impact Hub Berlin was kept and complemented with a mix of vintage pieces or furniture rentals. Functional elements such as cables, sanitary installations, ventilation pipes and heaters were also second-hand. The use of a new materials, in the form of hemp walls for example, provides a healthy</span><span lang=\"NL\">&nbsp;indoor climate a</span><span lang=\"EN-US\">s well as sound insulation. Felt and straw panels also serve to boost the acoustics.&nbsp;</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">&nbsp;</span>Impact Hub Berlin at CRCLR-House shows how preserving existing structures and using sustainable, renewable and recycled materials can positively shape tomorrow&rsquo;s buildings.</p>\n<p class=\"Body\">&nbsp;</p>\n<h4>PUBLICATIONS</h4>\n<p><a href=\"../assets/uploads/projects-news/press/New%20Work%20in%20zirkul%C3%A4rer%20%C3%84sthetik%20Cradle%205%20CMA.pdf\" target=\"_blank\" rel=\"noopener\">CRADLE Magazin 11/24</a><a href=\"https://www.md-mag.com/projekte/bueros-objektbauten/coworking-space-von-lxsy/\" target=\"_blank\" rel=\"noopener\"><br /></a><a href=\"assets/uploads/projects-news/press/LXSY_FOGS-Magazin.pdf\" target=\"_blank\" rel=\"noopener\">FOGS Green Style Magazin 11/24</a><a href=\"https://www.md-mag.com/projekte/bueros-objektbauten/coworking-space-von-lxsy/\" target=\"_blank\" rel=\"noopener\"><br /></a><a href=\"assets/uploads/projects-news/press/architektur.aktuell.pdf\" target=\"_blank\" rel=\"noopener\">architektur.aktuell 09/24</a><a href=\"https://www.md-mag.com/projekte/bueros-objektbauten/coworking-space-von-lxsy/\" target=\"_blank\" rel=\"noopener\"><br /></a><a href=\"assets/uploads/projects-news/press/LXSY_architektur-Fachmagazin.pdf\" target=\"_blank\" rel=\"noopener\">architektur FACHMAGAZIN 07/24</a><a href=\"https://www.md-mag.com/projekte/bueros-objektbauten/coworking-space-von-lxsy/\" target=\"_blank\" rel=\"noopener\"><br /></a><a href=\"https://www.cube-magazin.de/artikel/nachhaltig-und-zirkulaer/\" target=\"_blank\" rel=\"noopener\">CUBE Berlin 04/24</a><br /><a href=\"https://www.md-mag.com/projekte/bueros-objektbauten/coworking-space-von-lxsy/\" target=\"_blank\" rel=\"noopener\">md mag 08/23</a><br /><a href=\"assets/uploads/projects-news/press/LXSY_IMPACT-HUB-BERLIN-at-CRCLR-HOUSE_0723_DETAIL.pdf\" target=\"_blank\" rel=\"noopener\">DETAIL 07/2023</a><br /><a href=\"https://www.architonic.com/en/story/palmberg-circularity-that-inspires-the-palmberg-intelligence-series/20734710\" target=\"_blank\" rel=\"noopener\">ARCHITONIC 07/23</a><br /><a href=\"../assets/uploads/projects-news/press/LXSY_Architekten_Arch+_OFM.pdf\" target=\"_blank\" rel=\"noopener\">ARCH+ 06/23</a><br /><a href=\"https://www.polis-award.com/teilnehmer/impact-hub-berlin-at-crclr-house-cfb411a0/\" target=\"_blank\" rel=\"noopener\">polis AWARD 04/23</a><br /><a href=\"assets/uploads/projects-news/press/LXSY_IMPACT-HUB-BERLIN-at-CRCLR-HOUSE_Jahrbuch-Architektur-Berlin_0323.pdf\" target=\"_blank\" rel=\"noopener\">Building Berlin 03/23</a><br /><a href=\"assets/uploads/projects-news/press/LXSY_IMPACT-HUB-BERLIN-at-CRCLR-HOUSE_0323-Bauwelt.pdf\" target=\"_blank\" rel=\"noopener\">Baunetz Praxis 03/23</a><br /><a href=\"https://www.baunetzwissen.de/treppen/objekte/buero-gewerbe/crclr-house-in-berlin-8098882?wt_mc=nlbw.Treppen.2023-01.Objekte-Buero%2FGewerbe.cid-8098882&amp;context=3201\" target=\"_blank\" rel=\"noopener\">Baunetz Wissen 01/23</a><br /><a href=\"https://www.ad-magazin.de/artikel/zirkulares-bauen-lxsy-berlin\" target=\"_blank\" rel=\"noopener\">AD 12/22</a><br /><a href=\"https://www.nbau.org/2022/12/08/transformation-bauen-das-crclr-haus-in-berlin/\" target=\"_blank\" rel=\"noopener\">nbau 12/22</a><br /><a href=\"KARLSON 11/22\" target=\"_blank\" rel=\"noopener\">KARLSON 11/22</a><br /><a href=\"baunetz id 11/22\" target=\"_blank\" rel=\"noopener\">baunetz id 11/22</a><br /><a href=\"AD 11/22\" target=\"_blank\" rel=\"noopener\">AD 11/22</a><br /><a href=\"assets/uploads/projects-news/press/Die-Architekt_5-2022.pdf\" target=\"_blank\" rel=\"noopener\">Die Architekt 10/22</a><br /><a href=\"assets/uploads/projects-news/press/LXSY_AIT_10-22.pdf\" target=\"_blank\" rel=\"noopener\">AIT 10/22</a><br /><a href=\"https://www.german-architects.com/de/architecture-news/bau-der-woche/in-kreislaufen-planen-und-bauen\" target=\"_blank\" rel=\"noopener\">German-Architects 09/22</a><br /><a href=\"https://www.swiss-architects.com/de/architecture-news/meldungen/margit-sichrovsky-und-kim-le-roux-zirkulares-bauen-funktioniert-nicht-ohne-eine-zirkulare-wirtschaft-wir-brauchen-neue-geschaftsmodelle\" target=\"_blank\" rel=\"noopener\">Swiss-Architects 08/22</a><br /><a href=\"https://www.swr.de/swr2/wissen/bauen-mit-recycling-material-das-haus-als-rohstofflager-swr2-wissen-2022-04-12-100.html?fbclid=IwAR0qMdlBV5WoOMEl-CiKEr2uFVgk-ZK8sANaxiZYWOvnOaSVmYgY62qFxJ4\" target=\"_blank\" rel=\"noopener\">SWR2 04/22</a><br /><a href=\"assets/uploads/projects-news/press/ImpactHubBerlin-at-CRCLR-House_materialReport.pdf\" target=\"_blank\" rel=\"noopener\">materialREPORT 02/22</a><br /><br /><br /></p>\n<p class=\"Body\"><span lang=\"EN-US\"><a href=\"https://www.polis-award.com/teilnehmer/impact-hub-berlin-at-crclr-house-cfb411a0/\" target=\"_blank\" rel=\"noopener\"><img src=\"assets/pA23_&Ouml;kologischeWirklichkeit_ImpactHubBerlin.png\" alt=\"\" width=\"900\" height=\"245\" /></a>&nbsp;</span></p>\n<p class=\"Body\"><span lang=\"EN-US\"><img src=\"assets/uploads/projects-news/news/LXSY_DAM-Pr.png\" alt=\"\" width=\"1081\" height=\"1080\" />&nbsp;</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">&nbsp;</span></p>\n<p class=\"Body\"><span lang=\"EN-US\">&nbsp;</span></p>\n</div></div>\n                \n                <div class=\"content-right\">\n                    <div class=\"project-infos\">\n                        <div class=\"information-wrapper\"><span class=\"information-title\">Topic</span><span class=\"information-content\">Community and coworking space in circular design</span></div><br>\n                        <div class=\"information-wrapper\"><span class=\"information-title\">Category</span><span class=\"information-content\">Realisation</span></div><br>\n                        <div class=\"information-wrapper\"><span class=\"information-title\">Year</span><span class=\"information-content\">2022</span></div><br>\n                        \n                        <div class=\"information-wrapper\"><span class=\"information-title\">Location</span><span class=\"information-content\">DE – Berlin Neukölln</span></div><br>\n                        \n                        <div class=\"information-wrapper\"><span class=\"information-title\">BGF</span><span class=\"information-content\">1.780 sq m</span></div><br>\n                        <div class=\"information-wrapper\"><span class=\"information-title\">Awards</span><span class=\"information-content\">polis AWARD, DAM PREIS 2024 nominee, FRAME AWARD 2023, Heinze Award 223 nominee, bundespreis ecodesign 2025 nominee</span></div><br>\n                        \n                        <div class=\"information-wrapper\"><span class=\"information-title\">Client</span><span class=\"information-content\">\n                            <a class=\"information-link\" target=\"_blank\" href=\"https://berlin.impacthub.net/de/\">\n                                Impact Hub Berlin GmbH\n                             </a>\n                        </span></div><br>\n                        \n                        <div class=\"information-wrapper\"><span class=\"information-title\">Workshop</span><span class=\"information-content\">Sustainable Building Workshop</span></div><br>\n                        \n                        <div class=\"information-wrapper\"><span class=\"information-title\">Team</span><span class=\"information-content\">Kim Le Roux, Margit Sichrovsky, Lina Aakeroy, Rasa Weber, Sophia Wenzler</span></div><br>\n                        \n                        <div class=\"information-wrapper\"><span class=\"information-title\">Partner</span><span class=\"information-content\">\n                            <a class=\"information-link\" target=\"_blank\" href=\"https://www.trnsfrm.org\">\n                                TRNSFRM eG\n                            </a>\n                            \n                                \n                            \n                            \n                                \n                            \n                        </span></div><br>\n                        \n                        \n                        \n                        \n                        \n                        \n                        \n                        <div class=\"information-wrapper\"><span class=\"information-title\">Photos</span><span class=\"information-content\">\n                            <a class=\"information-link\" target=\"_blank\" href=\"https://studiobowie.de/de/\">\n                                Studio Bowie\n                            </a>\n                        </span></div><br>\n                        \n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n        <footer>\n    <div class=\"container\">\n    <div class=\"row\">\n        <div class=\"col-3\">\n            Lützowstr. 102-104<br>\n            Hof 3 | Aufgang E<br>\n            10785 Berlin\n        </div>\n        <div class=\"col-3\">\n            <a href=\"https://www.facebook.com/LXSY.Architektur/\" target=\"_blank\">FACEBOOK</a><br>\n            <a href=\"https://www.instagram.com/lxsy.architektur/\" target=\"_blank\">INSTAGRAM</a><br>\n            <a href=\"https://www.linkedin.com/company/lxsy-architektur\" target=\"_blank\">LINKEDIN</a><br>\n        </div>\n        <div class=\"col-3\">\n            <a href=\"tel:+4930235995500\">+49 30 2359955-00</a><br>\n            <a href=\"mailto:info@lxsy.d