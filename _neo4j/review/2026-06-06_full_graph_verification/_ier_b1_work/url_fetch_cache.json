                </div>\n                </div>\n            </div>\n        </section>\n    \n    <div class=\"bg-brand-yellow-500 pb-40\">\n        <header class=\"pt-[76px] lg:pt-[82px]\">\n                <div class=\"base-container pt-8 lg:pt-12 xl:pt-20\">\n                    <div class=\"base-grid gap-y-8 lg:gap-y-12 xl:gap-y-14\">\n                                                <div class=\"aspect-video w-full col-span-12 xl:col-start-2 xl:col-span-10\">\n        <div class=\"swiper h-full\" data-controller=\"image-carousel\">\n            <div class=\"swiper-wrapper\">\n                                    <div class=\"swiper-slide\">\n                        <figure class=\"aspect-video w-full\">\n                                                                                            \n            \n                                                                                                                                                                                                                                                                                                        <img class=\"w-full h-full object-cover object-center lazyload\" src=\"data:image/svg+xml,%3Csvgxmlns=&#039;http://www.w3.org/2000/svg&#039;%3E%3Crectwidth=&#039;1&#039;height=&#039;1&#039;fill=&#039;red&#039;/%3E%3C/svg%3E\" width=\"1220\" height=\"686\" alt=\"KA13_Mad arkitekter_Kyrre Sundal-7\" title=\"KA13_Mad arkitekter_Kyrre Sundal-7 | Arkitekt: MAD Arkitekter | Fotograf: Kyrre Sundal, MAD Arkitekter\" data-src=\"/assets//transforms/pilotprojects/_1220x686_crop_center-center_82_none/104373/575590.jpg\" data-srcset=\"/assets//transforms/pilotprojects/_1220x686_crop_center-center_82_none/104373/575590.jpg, /assets//transforms/pilotprojects/_2440x1372_crop_center-center_82_none/104373/575590.jpg 2x, /assets//transforms/pilotprojects/_3660x2058_crop_center-center_82_none/104373/575590.jpg 3x\">\n                        \n                        </figure>\n         