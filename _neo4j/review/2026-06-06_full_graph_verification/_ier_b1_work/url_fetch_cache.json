840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F8a70514ffe425abf3455c45eb17908e2292519cf-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F8a70514ffe425abf3455c45eb17908e2292519cf-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F8a70514ffe425abf3455c45eb17908e2292519cf-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F8a70514ffe425abf3455c45eb17908e2292519cf-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F8a70514ffe425abf3455c45eb17908e2292519cf-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75\"/><div class=\" absolute inset-0 flex items-center justify-center group md:opacity-0 hover:opacity-100 duration-300 z-10 cursor-pointer\"><button data-active=\"false\" class=\"pointer-events-none !leading-none uppercase rounded-[40px] border transition-colors duration-200 inline-block text-12 md:text-16 py-[0.2rem] px-[0.5rem] text-white border  hover:bg-white hover:text-black hover:border-white data-[active=true]:bg-white data-[active=true]:text-black data-[active=true]:border-white cursor-pointer\">Show image</button></div></span></div><figcaption class=\"italic text-12 mt-2 [&amp;_mark]:text-primary [&amp;_mark]:bg-transparent\">Copyright: Hampus Berndtson</figcaption></figure><p><strong>Concrete</strong><br/>Floor slabs were cut, and selected TT-decks were repurposed into long tables for meeting rooms and the café, as well as benches in the lobby and library.</p><figure class=\"my-12 md:my-20\"><div class=\"relative w-full h-0\" style=\"padding-bottom:133.33333333333331%\"><span class=\"absolute inset-0 w-full h-full block\"><img class=\"absolute inset-0 w-full h-full object-cover object-center\" src=\"https://cdn.sanity.io/images/o0gogd4q/production/f6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg?w=20&amp;blur=20&amp;q=20&amp;fit=max&amp;auto=format\"/><img alt=\"{{}}\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent\" sizes=\"1500px\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=16&amp;q=75 16w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Ff6fe61f635e80a0ca8d5396cb575b9e84bae8dd7-3840x5120.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75\"/><div class=\" absolute inset-0 flex items-center justify-center group md:opacity-0 hover:opacity-100 duration-300 z-10 cursor-pointer\"><button data-active=\"false\" class=\"pointer-events-none !leading-none uppercase rounded-[40px] border transition-colors duration-200 inline-block text-12 md:text-16 py-[0.2rem] px-[0.5rem] text-white border  hover:bg-white hover:text-black hover:border-white data-[active=true]:bg-white data-[active=true]:text-black data-[active=true]:border-white cursor-pointer\">Show image</button></div></span></div><figcaption class=\"italic text-12 mt-2 [&amp;_mark]:text-primary [&amp;_mark]:bg-transparent\">Copyright: Hampus Berndtson</figcaption></figure><h3>Custom-Designed Furniture from Svanninge Bjerge Wood</h3><p>The Bikuben Foundation manages the Svanninge Bjerge nature reserve in southern Funen to increase biodiversity. Some trees that were already scheduled to be felled to allow more light to reach the forest floor were transformed into furniture now featured at Thoravej 29.</p><p>Typically, furniture production involves ordering raw planks from a lumberyard. In this case, Pihlmann Architects, the Bikuben Foundation, and designer Sara Martinsen personally selected the trees in the forest.</p><figure class=\"my-12 md:my-20\"><div class=\"relative w-full h-0\" style=\"padding-bottom:66.73913043478261%\"><span class=\"absolute inset-0 w-full h-full block\"><img class=\"absolute inset-0 w-full h-full object-cover object-center\" src=\"https://cdn.sanity.io/images/o0gogd4q/production/3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg?w=20&amp;blur=20&amp;q=20&amp;fit=max&amp;auto=format\"/><img alt=\"{{}}\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent\" sizes=\"1500px\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=16&amp;q=75 16w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F3458f31068be2d56e165e3a0d2994f570cd8e119-7360x4912.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75\"/><div class=\" absolute inset-0 flex items-center justify-center group md:opacity-0 hover:opacity-100 duration-300 z-10 cursor-pointer\"><button data-active=\"false\" class=\"pointer-events-none !leading-none uppercase rounded-[40px] border transition-colors duration-200 inline-block text-12 md:text-16 py-[0.2rem] px-[0.5rem] text-white border  hover:bg-white hover:text-black hover:border-white data-[active=true]:bg-white data-[active=true]:text-black data-[active=true]:border-white cursor-pointer\">Show image</button></div></span></div><figcaption class=\"italic text-12 mt-2 [&amp;_mark]:text-primary [&amp;_mark]:bg-transparent\">Copyright: Karina Tybjeg</figcaption></figure><p>Working with wood from a biodiversity-focused forest sometimes requires adjustments to the schedule – for example, tree felling had to be postponed to avoid disturbing the birds’ breeding season.</p><p>The design and carpentry studio<a text=\" Archival Studies\" markType=\"link\" markKey=\"24b69e742c5f\" class=\"underline\" target=\"_blank\" rel=\"nofollow\" href=\"https://archivalstudies.net/\"> Archival Studies</a> was chosen by Pihlmann Architects and Sara Martinsen to design and produce outdoor furniture for the rooftop terrace and high chairs for the ground-floor café. They also explored the potential of using “green” (unseasoned) wood directly from the forest. Working with wet wood reduces energy consumption because it avoids drying and post-processing, while also allowing a greater portion of the tree trunk to be utilized compared to conventional furniture production.</p><figure class=\"my-12 md:my-20\"><div class=\"relative w-full h-0\" style=\"padding-bottom:132.5077399380805%\"><span class=\"absolute inset-0 w-full h-full block\"><img class=\"absolute inset-0 w-full h-full object-cover object-center\" src=\"https://cdn.sanity.io/images/o0gogd4q/production/d5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png?w=20&amp;blur=20&amp;q=20&amp;fit=max&amp;auto=format\"/><img alt=\"{{}}\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent\" sizes=\"1500px\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=16&amp;q=75 16w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Fd5c8421cb01fbe8d6476d5890ef5cc4fcc0fd555-969x1284.png%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75\"/><div class=\" absolute inset-0 flex items-center justify-center group md:opacity-0 hover:opacity-100 duration-300 z-10 cursor-pointer\"><button data-active=\"false\" class=\"pointer-events-none !leading-none uppercase rounded-[40px] border transition-colors duration-200 inline-block text-12 md:text-16 py-[0.2rem] px-[0.5rem] text-white border  hover:bg-white hover:text-black hover:border-white data-[active=true]:bg-white data-[active=true]:text-black data-[active=true]:border-white cursor-pointer\">Show image</button></div></span></div><figcaption class=\"italic text-12 mt-2 [&amp;_mark]:text-primary [&amp;_mark]:bg-transparent\">Copyright: Emilia Boeng Nordland</figcaption></figure><p>Selected Nordic wood species include pine, grandis, larch, Douglas fir, beech, and maple, along with some cypress. Oak was deliberately avoided by Archival Studies and Sara Martinsen to demonstrate that aesthetic and functional furniture can also be made from fast-growing, more affordable species.</p><p>The goal was also to create variety in wood types, since overreliance on a narrow selection in production forests leads to monocultures. This approach may inspire the use of alternative wood species beyond oak, which has long been the most sought-after timber.</p><h3>Designers Behind the Furniture</h3><p>In addition to Archival Studies, the exhibition platform and creative community <a text=\"Ukurant\" markType=\"link\" markKey=\"107758ac4b17\" class=\"underline\" target=\"_blank\" rel=\"nofollow\" href=\"https://ukurant.com/\">Ukurant</a> selected talented young designers to create custom furniture for Thoravej 29:</p><h3>Design Duo: <a text=\"Christian + Jade\" markType=\"link\" markKey=\"2a1791b3293a\" class=\"underline\" target=\"_blank\" rel=\"nofollow\" href=\"https://www.christianandjade.com/\">Christian + Jade</a></h3><p><em>12 Stools</em><br/>In the spirit of sustainability, three beams of grandis wood from Svanninge Bjerge (15 × 15 × 400 cm) were sliced to produce exactly twelve stools – no more, no less. The stools retain the natural weight and volume of the beams and draw inspiration from the visible construction and joinery of Thoravej 29. Each stool allows the “living” wood to move naturally, with cracks stabilized and highlighted by metal brackets that embrace and accentuate the material’s vitality.</p><figure class=\"my-12 md:my-20\"><div class=\"relative w-full h-0\" style=\"padding-bottom:149.98671978751662%\"><span class=\"absolute inset-0 w-full h-full block\"><img class=\"absolute inset-0 w-full h-full object-cover object-center\" src=\"https://cdn.sanity.io/images/o0gogd4q/production/56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg?w=20&amp;blur=20&amp;q=20&amp;fit=max&amp;auto=format\"/><img alt=\"{{}}\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent\" sizes=\"1500px\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=16&amp;q=75 16w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2F56ec7f36fc8f4931cfbe6be57ed5bb2978710d9b-3765x5647.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=3840&amp;q=75\"/><div class=\" absolute inset-0 flex items-center justify-center group md:opacity-0 hover:opacity-100 duration-300 z-10 cursor-pointer\"><button data-active=\"false\" class=\"pointer-events-none !leading-none uppercase rounded-[40px] border transition-colors duration-200 inline-block text-12 md:text-16 py-[0.2rem] px-[0.5rem] text-white border  hover:bg-white hover:text-black hover:border-white data-[active=true]:bg-white data-[active=true]:text-black data-[active=true]:border-white cursor-pointer\">Show image</button></div></span></div><figcaption class=\"italic text-12 mt-2 [&amp;_mark]:text-primary [&amp;_mark]:bg-transparent\">Copyright: Samuel Causse</figcaption></figure><h3>Designer: <a text=\"Anne Skaarup Jaedicke\" markType=\"link\" markKey=\"5a21c50e4bdb\" class=\"underline\" target=\"_blank\" rel=\"nofollow\" href=\"https://www.instagram.com/annethegreatest/\">Anne Skaarup Jaedicke</a></h3><p><em>12 Stools</em><br/>‘Taburet 29’ is crafted from grandis wood from Svanninge Bjerge. Its simple, geometric form serves as a canvas for surface embossing – the number “29,” reflecting the building’s address, emerges through stamped impressions. The raw and chaotic stamping is inspired by timber numbering during felling, creating a tactile depth and inviting viewers to experience the wood’s natural details anew.</p><figure class=\"my-12 md:my-20\"><div class=\"relative w-full h-0\" style=\"padding-bottom:150%\"><span class=\"absolute inset-0 w-full h-full block\"><img class=\"absolute inset-0 w-full h-full object-cover object-center\" src=\"https://cdn.sanity.io/images/o0gogd4q/production/aa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg?w=20&amp;blur=20&amp;q=20&amp;fit=max&amp;auto=format\"/><img alt=\"{{}}\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"absolute inset-0 w-full h-full object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:50% 50%;color:transparent\" sizes=\"1500px\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Faa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=16&amp;q=75 16w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Faa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Faa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Faa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Dformat&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fo0gogd4q%2Fproduction%2Faa9144319ecb7224c4f7ffab239a9aec74a1dc3b-3332x4998.jpg%3Fw%3D200%26blur%3D320%26q%3D80%26fit%3Dmax%26auto%3Df