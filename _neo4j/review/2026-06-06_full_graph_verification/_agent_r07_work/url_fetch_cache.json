ny delay to allow DOM changes -> then animate active dot\n            setTimeout(function () {\n                var $activeSpan = $owl.find('.owl-dot.active > span');\n                $activeSpan.css('animation', 'progressBar ' + (AUTOPLAY_MS / 1000) + 's linear forwards');\n            }, 10);\n        }\n\n        function startAutoplayTimer() {\n            clearTimeout(autoplayTimer);\n            startProgressAnimation();\n            autoplayTimer = setTimeout(function () {\n                $owl.trigger('next.owl.carousel');\n            }, AUTOPLAY_MS);\n        }\n\n        // initialize dots and start autoplay once carousel is ready\n        $owl.on('initialized.owl.carousel', function () {\n            ensureDotSpan();\n            startAutoplayTimer();\n        });\n\n        // If init already happened synchronously (rare), ensure start\n        if ($owl.hasClass('owl-loaded')) {\n            ensureDotSpan();\n            startAutoplayTimer();\n        }\n\n        // Restart timer when the slide changes (next/prev or when dot clicked)\n        $owl.on('changed.owl.carousel', function () {\n            // ensure dots exist (in case they were rendered lazily)\n            ensureDotSpan();\n            startAutoplayTimer();\n        });\n\n        // Clicking a dot: let owl handle the navigation, then restart timer\n        $(document).on('click', sliderSelector + ' .owl-dot', function () {\n            // small delay so owl updates active class first\n            setTimeout(startAutoplayTimer, 50);\n        });\n\n        // Optional: pause on hover (stops timeout and animation)\n        $owl.on('mouseenter', function () {\n            clearTimeout(autoplayTimer);\n            $owl.find('.owl-dot > span').css('animation-play-state', 'paused');\n        }).on('mouseleave', function () {\n            $owl.find('.owl-dot > span').css('animation-play-state', 'running');\n            startAutoplayTimer();\n        });\n\n    });\n});\n</script>\n\n<!-- Minimal