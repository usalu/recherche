        Decarbonising steel                                    </span>\n                                    <span class=\"button__icon\">\n                                        <svg class=\"svg-fill\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9.44827 2.01321L7.98173 3.47975L11.8524 7.35045L1.04289 7.39217L1.03299 9.46824L11.8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                                    </span>\n                                </a>\n                                                    </div>\n                                                            <div class=\"ttm__card\">\n                                    \n        <picture \n            class=\"ttm__card-media-wrap \"\n                    >\n                            <source \n                    type=\"image/jpeg\"\n                    srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/09/r0002_Stockmatcher_9.jpg?w=854&amp;ssl=1 854w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/09/r0002_Stockmatcher_9.jpg?resize=400%2C600&amp;ssl=1 400w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/09/r0002_Stockmatcher_9.jpg?resize=683%2C1024&amp;ssl=1 683w\"\n                    sizes=\"(min-width: 1200px) 100vw,\n              (min-width: 601px) 100vw,\n              (max-width: 600px) 100vw\">\n                        \n            <source \n                type=\"image/jpeg\"\n                srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/09/r0002_Stockmatcher_9.jpg?w=854&amp;ssl=1 854w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/09/r0002_Stockmatcher_9.jpg?resize=400%2C600&amp;ssl=1 400w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/09/r0002_Stockmatcher_9.jpg?resize=683%2C1024&amp;ssl=1 683w\"\n                sizes=\"(min-width: 1200px) 100vw,\n              (min-width: 601px) 100vw,\n              (max-width: 600px) 100vw\">\n            \n            <img\n                src=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/09/r0002_Stockmatcher_9.jpg?fit=400%2C600&#038;ssl=1\"\n                width=\"854\"\n                height=\"1280\"\n                alt=\"\"\n                class=\"ttm__card-media\"\n                decoding=\"async\"\n                \n                                    loading=\"lazy\"\n                    fetchpriority=\"auto\"\n                \n                                />\n\n        </picture>\n    \n                                                            <a class=\"ttm__media-button button\" href=\"http://hts.uk.com/research-innovation/stockmatcher/\" target=\"\">\n                                    <span class=\"button__text\">\n                                        Stockmatcher tool                                    </span>\n                                    <span class=\"button__icon\">\n                                        <svg class=\"svg-fill\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9.44827 2.01321L7.98173 3.47975L11.8524 7.35045L1.04289 7.39217L1.03299 9.46824L11.8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                                    </span>\n                                </a>\n                                                    </div>\n                                                            <div class=\"ttm__card\">\n                                    \n        <picture \n            class=\"ttm__card-media-wrap \"\n                    >\n                            <source \n                    type=\"image/jpeg\"\n                    srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?w=2560&amp;ssl=1 2560w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=600%2C400&amp;ssl=1 600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=1024%2C683&amp;ssl=1 1024w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=1600%2C1067&amp;ssl=1 1600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=2048%2C1366&amp;ssl=1 2048w\"\n                    sizes=\"(min-width: 1200px) 100vw,\n              (min-width: 601px) 100vw,\n              (max-width: 600px) 100vw\">\n                        \n            <source \n                type=\"image/jpeg\"\n                srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?w=2560&amp;ssl=1 2560w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=600%2C400&amp;ssl=1 600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=1024%2C683&amp;ssl=1 1024w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=1600%2C1067&amp;ssl=1 1600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?resize=2048%2C1366&amp;ssl=1 2048w\"\n                sizes=\"(min-width: 1200px) 100vw,\n              (min-width: 601px) 100vw,\n              (max-width: 600px) 100vw\">\n            \n            <img\n                src=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2024/12/Culture_2024_HTS-Studio-17.jpg?fit=600%2C400&#038;ssl=1\"\n                width=\"2048\"\n                height=\"1366\"\n                alt=\"\"\n                class=\"ttm__card-media\"\n                decoding=\"async\"\n                \n                                    loading=\"lazy\"\n                    fetchpriority=\"auto\"\n                \n                                />\n\n        </picture>\n    \n                                                            <a class=\"ttm__media-button button\" href=\"http://hts.uk.com/news-views/the-life-of-a-summer-intern-at-hts/\" target=\"\">\n                                    <span class=\"button__text\">\n                                        Hear from our summer interns                                    </span>\n                                    <span class=\"button__icon\">\n                                        <svg class=\"svg-fill\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9.44827 2.01321L7.98173 3.47975L11.8524 7.35045L1.04289 7.39217L1.03299 9.46824L11.8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                                    </span>\n                                </a>\n                                                    </div>\n                                                </div>\n            </section>\n    <section class=\"culture-news\">\n                    <div class=\"culture-news__content grid-outer\">\n                <div class=\"grid-inner js-load-in\">\n                    <h2 class=\"js-load-in\"><b>Adventure and fun</b></h2><div class=\"rich-text flow-medium\"><p>We enjoy engineering and the business of design, continuing the spirit of adventure with which the practice was founded in 2007.</p>\n<p>Our enthusiasm for a challenge extends beyond our projects; whether it’s climbing a mountain, performing with the HTS band or volunteering at a local community garden.</p>\n<p>The result is a practice that’s fun and rewarding to be part of, and a team that’s enjoyable to work with.</p>\n</div>                        <a class=\"button\" href=\"http://hts.uk.com/news-views/category/adventure/\" target=\"\">\n                            <span class=\"button__text\">\n                                More adventures                            </span>\n\n                            <span class=\"button__icon\">\n                                <svg class=\"svg-fill\" width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9.44827 2.01321L7.98173 3.47975L11.8524 7.35045L1.04289 7.39217L1.03299 9.46824L11.8454 9.47177L7.96334 13.3538L9.44827 14.8387L15.861 8.42596L9.44827 2.01321Z\"/>\n</svg>\n                            </span>\n                        </a>\n                                    </div>\n            </div>\n        \n                    <div class=\"culture-news__cards news-related__grid js-load-in\">\n                <a href=\"https://hts.uk.com/news-views/5-minutes-with-sonny-dhand/\" class=\"card card--news js-load-in\">\n            \n        <picture \n            class=\"card__media-wrap \"\n                    >\n                            <source \n                    type=\"image/jpeg\"\n                    srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_28_uncropped.jpg?w=2500&amp;ssl=1 2500w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_28_uncropped.jpg?resize=600%2C450&amp;ssl=1 600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_28_uncropped.jpg?resize=1024%2C768&amp;ssl=1 1024w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_28_uncropped.jpg?resize=1600%2C1200&amp;ssl=1 1600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_28_uncropped.jpg?resize=2048%2C1536&amp;ssl=1 2048w\"\n                    sizes=\"(min-width: 1200px) 60vw,\n              (min-width: 601px) 60vw,\n              (max-width: 600px) 100vw\">\n                        \n            <source \n                type=\"image/jpeg\"\n                srcset=\"https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_28_uncropped.jpg?w=2500&amp;ssl=1 2500w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_28_uncropped.jpg?resize=600%2C450&amp;ssl=1 600w, https://i0.wp.com/hts.uk.com/wp-content/uploads/2025/12/n0057_Highways-IF_2