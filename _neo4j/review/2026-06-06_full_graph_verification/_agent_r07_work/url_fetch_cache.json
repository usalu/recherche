le=\"Home\" rel=\"home\" class=\"site-branding__logo\">\n      <img src=\"/themes/custom/pml_basetheme/logo-original.svg\" alt=\"Home\" />\n    </a>\n    </div>\n\n</div>\n          </div>\n        </div>\n      \n              <div class=\"grid search\">\n          <div class=\"grid col-12 contained search\">\n            <div class=\"grid col-12 search\">  <div class=\"views-exposed-form bef-exposed-form front-search col-6_sm-12 settings-tray-editable block block-views block-views-exposed-filter-blockstock-free-search-page-1\" data-drupal-selector=\"views-exposed-form-stock-free-search-page-1\" data-aos=\"fade-up\" data-push-left=\"off-4_md-0\" data-drupal-settingstray=\"editable\">\n  \n      <h2><em>REDUCE COSTS</em><em>REDUCE DELIVERY TIMES</em><em>REDUCE CARBON EMISSIONS</em></h2>\n    \n      <div class=\"content\">\n      <form action=\"/stock-search\" method=\"get\" id=\"views-exposed-form-stock-free-search-page-1\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item js-form-type-textfield form-item-od js-form-item-od\">\n      \n        <input data-drupal-selector=\"edit-od\" type=\"text\" id=\"edit-od\" name=\"od\" value=\"\" size=\"30\" maxlength=\"128\" placeholder=\"Diameter (OD-mm)\" class=\"form-text\" />\n\n        </div>\n<div class=\"js-form-item form-item js-form-type-textfield form-item-wall js-form-item-wall\">\n      \n        <input data-drupal-selector=\"edit-wall\" type=\"text\" id=\"edit-wall\" name=\"wall\" value=\"\" size=\"30\" maxlength=\"128\" placeholder=\"Wall Thickness (mm)\" class=\"form-text\" />\n\n        </div>\n<div data-drupal-selector=\"edit-actions\" class=\"form-actions js-form-wrapper form-wrapper\" id=\"edit-actions\"><input data-drupal-selector=\"edit-submit-stock-free-search\" type=\"submit\" id=\"edit-submit-stock-free-search\" value=\"Search\" class=\"button js-form-submit form-submit\" />\n</div>\n\n\n</form>\n\n    </div>\n  </div>\n<div class=\"view-all-stock col-6_sm-12 settings-tray-editable block block-block-content block-block-contenta2ddd8ec-f756-410b-985c-4bf6c4b61335\" data-aos=\"fade-up\" data-push-left=\"off-4_md-0\" data-drupal-settingstray=\"editable\">\n  \n    \n      <div class=\"content\">\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p><a class=\"blue\" href=\"/stock-search?od=&amp;wall=\" title=\"View all stock\">View all stock</a></p>\n</div>\n      \n    </div>\n  </div>\n\n</div>\n          </div>\n        </div>\n      \n      \n    </div>\n\n                      <div id=\"main-wrapper\" class=\"fw-container clearfix\">\n        <div id=\"main\" class=\"contained grid clearfix\">\n          <main id=\"content\" class=\"col-12 main-content\" role=\"main\">\n            <section class=\"section grid\">\n              <a id=\"main-content\" tabindex=\"-1\"></a>\n                <div data-drupal-messages-fallback class=\"hidden\"></div>\n<div id=\"block-pml-basetheme-content\" class=\"block block-system block-system-main-block\">\n  \n    \n      <div class=\"content\">\n      <article data-history-node-id=\"4372\" about=\"/largest-stockholders-steel-tubes-uk\" typeof=\"schema:WebPage\">\n\n  \n      <span property=\"schema:name\" content=\"The largest Stockholders &lt;br&gt;of Steel Tubes in the UK\" class=\"hidden\"></span>\n\n\n  \n  <div>\n    \n            <div property=\"schema:text\" class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"></div>\n      \n      <div class=\"field field--name-field-paragraphs field--type-entity-reference-revisions field--label-hidden field__items\">\n              <div class=\"field__item grid\">  <div class=\"paragraph paragraph--type--full-width-text paragraph--view-mode--default\">\n          <div class=\"col-12\">\n        \n            <div class=\"field field--name-field-text field--type-text-long field--label-hidden field__item\"><h2>We’re promoting the use of surplus steel tube</h2>\n\n<p><strong>The use of surplus steel tube in construction and infrastructure projects can deliver huge savings on material costs, delivery lead times and up to 96% on carbon emissions. Our message is ‘don’t always specify newly milled steel for projects’ as surplus steel tube from steel mills and oil and gas projects can often surpass the specification required for construction and infrastructure projects. &nbsp;</strong></p>\n\n<p>And, we can supply independent material testing certification reports for all of our stock.</p>\n</div>\n      \n      </div>\n      </div>\n</div>\n              <div class=\"field__item grid\">  <div class=\"reduce-blocks paragraph grid paragraph--type--three-column-text paragraph--view-mode--default\">\n          <div class=\"col-4_sm-12\">\n        <div class=\"content\">\n          \n            <div class=\"field field--name-field-text field--type-text-long field--label-hidden field__item\"><div class=\"align-center\">\n  \n  \n  <div class=\"field field--name-field-media-image field--type-image field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">Image</div>\n              <div class=\"field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/1200_max/public/2021-09/costs_0.png?itok=hLdj5w-I\" width=\"186\" height=\"186\" alt=\"Reduce costs\" typeof=\"foaf:Image\">\n\n\n</div>\n          </div>\n\n</div>\n\n\n<p><strong>Reduce</strong><br>\ncosts</p>\n</div>\n      \n        </div>\n      </div>\n      <div class=\"col-4_sm-12\">\n        <div class=\"content\">\n          \n            <div class=\"field field--name-field-second-column-text field--type-text-long field--label-hidden field__item\"><div class=\"align-center\">\n  \n  \n  <div class=\"field field--name-field-media-image field--type-image field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">Image</div>\n              <div class=\"field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/1200_max/public/2021-09/leadtimes_0.png?itok=HduLQRH4\" width=\"186\" height=\"186\" alt=\"Reduce leadtimes\" typeof=\"foaf:Image\">\n\n\n</div>\n          </div>\n\n</div>\n\n\n<p><strong>Reduce</strong><br>\nlead times</p>\n</div>\n      \n        </div>\n      </div>\n      <div class=\"col-4_sm-12\">\n        <div class=\"content\">\n          \n            <div class=\"field field--name-field-third-column-text field--type-text-long field--label-hidden field__item\"><div class=\"align-center\">\n  \n  \n  <div class=\"field field--name-field-media-image field--type-image field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">Image</div>\n              <div class=\"field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/1200_max/public/2021-09/carbon_0.png?itok=IiblAP56\" width=\"186\" height=\"186\" alt=\"Reduce carbon\" typeof=\"foaf:Image\">\n\n\n</div>\n          </div>\n\n</div>\n\n\n<p><strong>Reduce</strong><br>\ncarbon emissions&nbsp;</p>\n</div>\n      \n        </div>\n      </div>\n      </div>\n</div>\n              <div class=\"field__item grid\">  <div class=\"greener-pullout blue-links paragraph grid paragraph--type--text-left-block-right paragraph--view-mode--default\">\n          <div class=\"col-6_sm-12\">\n        \n            <div class=\"field field--name-field-text field--type-text-long field--label-hidden field__item\"><h2>We hold 84,000 tonnes of Certified and Uncertified stock</h2>\n\n<h3>Established in 1973, we are one of the&nbsp;largest stockholders of steel tubes in Europe with 84,000 tonnes of material held at our 100-acre facility in North Yorkshire, UK.</h3>\n\n<p>We are also founder members of the multinational <a href=\"/about-us\">Bianco Group</a>, with associate companies worldwide. This means our customers have access to over 250,000 tonnes of material held in stock within our group at any one time.</p>\n\n<p>Our business is based on supplying our customers with steel tubes that meet their requirements at highly competitive prices. Depending on the source and conditions of purchase, our stock is divided into two broad categories, Uncertified/Non Prime&nbsp;and Certified/Prime. <a href=\"/our-range-steel-tube-stock\">Our stock profile</a> includes 40% of Certified material, complementing our more cost-effective Uncertified material, which can always be issued with independent test reports based on your needs.</p>\n</div>\n      \n      </div>\n      <div class=\"col-6_sm-12\">\n        \n            <div class=\"field field--name-field-block field--type-block-field field--label-hidden field__item\"><div id=\"block-pioneeringgreener\" class=\"block block-block-content block-block-content5a41610a-0dbd-499d-b03e-392385cf49b6\">\n  \n    \n      <div class=\"content\">\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><h2>We're pioneering the concept of greener steel. Search our stock and reduce your project carbon footprint</h2>\n\n<p><a class=\"orange\" href=\"/sustainability\">Read more</a></p>\n</div>\n      \n    </div>\n  </div>\n</div>\n      \n      </div>\n      </div>\n</div>\n              <div class=\"field__item grid\">  <div class=\"video blue-links paragraph paragraph--type--full-width-text paragraph--view-mode--default\">\n          <div class=\"col-12\">\n        \n            <div class=\"field field--name-field-text field--type-text-long field--label-hidden field__item\"><div data-aos=\"fade-up\">\n<h1><span class=\"light\">Our</span> Site</h1>\n\n<div class=\"videoWrapper\"><iframe allow=\"accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen frameborder=\"0\" height=\"315\" src=\"https://www.youtube.com/embed/niOqJ3s8Wwk?rel=0\" width=\"560\"></iframe></div>\n</div>\n</div>\n      \n      </div>\n      </div>\n</div>\n              <div class=\"field__item grid\">  <div class=\"grey-block blue-links paragraph grid paragraph--type--text-left-image-right paragraph--view-mode--default\">\n          <div class=\"col-6_sm-12\">\n        \n            <div class=\"field field--name-field-text field--type-text-long field--label-hidden field__item\"><h2>Wide range of options in stock</h2>\n\n<h3>Whilst our stock is kept in random lengths, generally from 4.5m up to about 15m, you have the option of having shorter cut pieces or extended lengths with circumferential welds. Our <a href=\"/services\">on-site services</a> include: cutting, welding, shot blasting, painting, worldwide logistics and storage facilities.</h3>\n\n<p>Our stock holding features an extensive range of long-welded, spirally welded and seamless steel tube with outer dimensions ranging from 42mm up to 2,500mm. Wall thicknesses are from 2.6mm up to 184mm and steel API grades are from Gr. B up to grade X80. BS/EN steel grades are from S185 to S460.</p>\n\n<p>We are BS EN ISO 9001:2015 certified for our <a href=\"/downloads\">quality management system</a> which demonstrates our ability to consistently provide products and services that meet customer and regulatory requirements. <a href=\"/downloads\">Download copies of our certificates here</a>.</p>\n\n<p>We supply to a wide range of industries including; civil engineering &amp; construction, defence, mining &amp; quarrying, oil and gas exploration &amp; processing, marine, piling, rail, renewable energy &amp; power utilities, sports &amp; leisure.</p>\n\n<p><a class=\"orange\" href=\"/stock-search\">Check our current stock online here</a></p>\n</div>\n      \n      </div>\n      <div class=\"col-6_sm-12\">\n        \n            <div class=\"field field--name-field-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n  <div class=\"field field--name-field-media-image field--type-image field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">Image</div>\n              <div class=\"field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/1200_max/public/2019-10/pipes-100.jpg?itok=-AGy1BK4\" width=\"570\" height=\"380\" alt=\"Black and white photograph of some CST stock\" typeof=\"foaf:Image\" />\n\n\n</div>\n          </div>\n\n</div>\n</div>\n      \n      </div>\n      </div>\n</div>\n          </div>\n  \n  </div>\n\n</article>\n\n    </div>\n  </div>\n\n\n            </section>\n          </main>\n        </div>\n      </div>\n              <div class=\"fw-container grid featured-bottom-first\">\n        <div class=\"col-12 grid contained featured-bottom-first\">  <div class=\"certified white-links settings-tray-editable block block-block-content block-block-content57588006-2706-4439-b9a4-eb983f7d1b77\" data-aos=\"fade-up\" data-push-left=\"off-7_md-0\" data-push-right=\"off-1_md-0\" data-drupal-settingstray=\"editable\">\n  \n    \n      <div class=\"content\">\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><h2>Certified/Prime stock</h2>\n\n<p>Our Certified or Prime stock is material we have purchased complete with the producers test certification. This material is typically purchased directly from the steel producers or from sources that can provide traceability between the material and the certification supplied.</p>\n\n<h2>Uncertified/Non Prime stock</h2>\n\n<p>Our Uncertified/Non Prime stock includes mills’ over rolling and second quality material, together with unused surplus stock from completed projects or, redundant stock where certification may have existed but where traceability is no longer available. Our business model has synergies with <a href=\"/sustainability\">circular economy principles</a> and we are committed to working with our customers to offer a sustainable supply chain solution. Reuse of unused and surplus material can have a significant impact on carbon savings for your project. This stock is available at a much more competitive price to Certified/Prime steel tube. It is also available with significantly reduced lead times.&nbsp;</p>\n</div>\n      \n    </div>\n  </div>\n\n</div>\n      </div>\n    \n          <div class=\"fw-container grid featured-bottom-second\">\n        <div class=\"col-12 contained featured-bottom-second\">  <div class=\"icaw intad settings-tray-editable block block-block-content block-block-contentd98da5ba-43b8-4f4e-b5bb-fce4d69f5500\" data-aos=\"fade-up\" data-drupal-settingstray=\"editable\">\n  \n    \n      <div class=\"content\">\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><h2><span class=\"light\">International Commission Agents</span> Wanted</h2>\n\n<p>We're looking to expand our global network of sellers. Join our team.</p>\n\n<p><a class=\"orange\" href=\"/international-commission-agents-wanted\">Read more</a></p>\n</div>\n      \n    </div>\n  </div>\n<div class=\"sis intad settings-tray-editable block block-block-content block-block-content9af7dda5-fb35-415a-8931-3c05b41d8cb7\" data-aos=\"fade-up\" data-aos-delay=\"100\" data-drupal-settingstray=\"editable\">\n  \n    \n      <div class=\"content\">\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><h2>Go greener - <span class=\"light\">sustainability in steel</span></h2>\n\n<p>We're pioneering the concept of 'greener steel' to reduce carbon footprints.</p>\n\n<p>&nbsp;</p>\n\n<p><a class=\"orange\" href=\"/sustainability\">Read more</a></p>\n</div>\n      \n    </div>\n  </div>\n<div class=\"buy intad settings-tray-editable block block-block-content block-block-contented9af542-1cb7-4639-8e25-dc89ef3e758c\" data-aos=\"fade-up\" data-aos-delay=\"200\" data-drupal-settingstray=\"editable\">\n  \n    \n      <div class=\"content\">\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><h2><b>We're worldwide buyers <span class=\"light\">of surplus tube and pipe</span></b></h2>\n\n<p>We're interested in buying surplus pipeline project materials.</p>\n\n<p><a class=\"orange\" href=\"/sell-us\">Read more</a></p>\n</div>\n      \n    </div>\n  </div>\n\n</div>\n      </div>\n    \n          <div class=\"fw-container grid featured-bottom-third\">\n        <div class=\"col-12 contained featured-bottom-third\">  <div class=\"views-element-container latest-news settings-tray-editable block block-views block-views-blocklatest-news-block-1\" data-aos=\"fade-down\" data-drupal-settingstray=\"editable\">\n  \n      <h2>Latest News</h2>\n    \n      <div class=\"content\">\n      <div><div class=\"latest-news js-view-dom-id-67151999394abdfc4d11827e2184ae8721b2b24e0f7ff477ec81f8a05ff457cb\">\n  \n  \n  \n\n  \n  \n  \n\n  \n\n  <div class=\"view-content grid\">\n\n\n    <div  class=\"views-row col-4_md-6_sm-12 first odd\" data-aos=\"fade-up\">\n  \n    <div class=\"views-field views-field-fieldset\"><span class=\"field-content\">  <div  class=\"padwrap\">\n    <div class=\"views-field views-field-field-summary-image\"><div class=\"field-content\"><div>\n  \n  \n  <div class=\"field field--name-field-media-image field--type-image field--label-visually_hidden\">\n    <div class=\"field__label visually-hidden\">Image</div>\n              <div class=\"field__item\">  <img loading=\"lazy\" src=\"/sites/default/files/styles/1200_max/public/2019-11/gbc_1.png?itok=D8nEzPjf\" width=\"166\" height=\"141\" alt=\"Green Building Council\" typeof=\"foaf:Image\" />\n\n\n</div>\n          </div>\n\n</div>\n</div></div><div class=\"views-field views-field-title\"><span class=\"field-content\"><a href=\"/cleveland-steel-tubes-programme-partner-uk-green-building-council\" hreflang=\"en\">Cleveland Steel &amp; Tubes – Programme Partner to UK Green Building Council</a></span></div><div class=\"views-field views-field-view-node\"><span class=\"field-content blue\"><a href=\"/cleveland-steel-tubes-programme-partner-uk-green-building-co