  {edge_id: 'v10-003-01d', src_id: 'bg_reuse_stahl_tragwerk_k118_basel_steel_beams_candidate', tgt_id: 'wvo_extern_importiert', conf: 'belegt', url: 'https://zirkular.net/de/projekt/k-118-kopfbau-halle-118/', quote: 'The structural frame consists of steel beams recovered from partial dismantling of a hall at the ELYS project in Basel.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
  {edge_id: 'v10-003-02d', src_id: 'bg_reuse_stahl_treppe_k118_orion_stair_candidate', tgt_id: 'wvo_extern_importiert', conf: 'belegt', url: 'https://intergalva.com/awards/global-galvanizing-awards-2024/k-118-kopfbau-halle-118/', quote: 'The 22 m hot-dip galvanized emergency staircase from the Orion office building was dismantled after 28 years and reused for access to K118, needing only minor modifications.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
  {edge_id: 'v10-003-03d', src_id: 'bg_reuse_glas_fenster_k118_zurich_windows_candidate', tgt_id: 'wvo_extern_importiert', conf: 'belegt', url: 'https://se2050.org/wp-content/uploads/2024/08/SEI-CE-WG-Circular-Economy-Case-Studies_6-K118-Kopfbau-Halle.pdf', quote: 'Aluminium insulated windows from the Zurich office building were reused as-is or doubled to form box windows.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
  {edge_id: 'v10-003-04d', src_id: 'bg_reuse_naturstein_boden_k118_granite_candidate', tgt_id: 'wvo_extern_importiert', conf: 'belegt', url: 'https://se2050.org/wp-content/uploads/2024/08/SEI-CE-WG-Circular-Economy-Case-Studies_6-K118-Kopfbau-Halle.pdf', quote: 'Granite facade slabs from the Zurich office building were repurposed as kitchen and bathroom floor finishes and balcony pavers.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
  {edge_id: 'v10-003-05d', src_id: 'bg_reuse_metall_fassade_k118_red_sheets_candidate', tgt_id: 'wvo_extern_importiert', conf: 'belegt', url: 'https://se2050.org/wp-content/uploads/2024/08/SEI-CE-WG-Circular-Economy-Case-Studies_6-K118-Kopfbau-Halle.pdf', quote: 'Red facade metal sheets from the nearby Ziegler printing company were salvaged and overlapped instead of trimmed.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
  {edge_id: 'v10-003-06d', src_id: 'bg_reuse_holz_dach_k118_aarau_roof_elements_candidate', tgt_id: 'wvo_extern_importiert', conf: 'belegt', url: 'https://se2050.org/wp-content/uploads/2024/08/SEI-CE-WG-Circular-Economy-Case-Studies_6-K118-Kopfbau-Halle.pdf', quote: 'Roof elements from Aarau were among the additional salvaged materials used in K118.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
  {edge_id: 'v10-003-07d', src_id: 'bg_reuse_holz_tueren_k118_uster_doors_candidate', tgt_id: 'wvo_extern_importiert', conf: 'belegt', url: 'https://se2050.org/wp-content/uploads/2024/08/SEI-CE-WG-Circular-Economy-Case-Studies_6-K118-Kopfbau-Halle.pdf', quote: 'Solid wood doors from Uster were part of the salvaged material mix.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
