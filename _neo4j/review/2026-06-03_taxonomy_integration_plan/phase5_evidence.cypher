  {edge_id: 'v10-005-03a', src_id: 'p_meduni_campus_mariannengasse', tgt_id: 'bg_reuse_moebel_sitze_meduni_cinema_seats_candidate', conf: 'belegt', url: 'https://www.meduniwien.ac.at/web/en/about-us/news/detailsite/2019/news-im-dezember-2020/new-from-old-big-meduni-vienna-and-baukarussell-exploit-the-enormous-re-use-potential-of-meduni-mariannengasse-campus/', quote: 'The component catalogue included vintage cinema seats suitable for reuse in new properties.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
