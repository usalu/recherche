  {edge_id: 'v10-003-06e', src_id: 'bg_reuse_holz_dach_k118_aarau_roof_elements_candidate', tgt_id: 'rv_ausbau_von_bauteilen', conf: 'wahrscheinlich', url: 'https://se2050.org/wp-content/uploads/2024/08/SEI-CE-WG-Circular-Economy-Case-Studies_6-K118-Kopfbau-Halle.pdf', quote: 'Roof elements from Aarau were among the additional salvaged materials used in K118.', batch: 'reuse_taxonomy_v9_connection_expansion_batch_10.md'},
