{
  "mcpServers": {
    "Neo4j-Official": {
      "command": "python",
      "args": [
        "-m",
        "neo4j_mcp_server"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "ENTWERFENMITBESTAND",
        "NEO4J_DATABASE": "mit-bestand",
        "NEO4J_READ_ONLY": "true",
        "NEO4J_TELEMETRY": "false",
        "NEO4J_LOG_LEVEL": "info",
